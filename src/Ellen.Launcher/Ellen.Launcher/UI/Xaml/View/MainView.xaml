<UserControl
    x:Class="Ellen.Launcher.UI.Xaml.View.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Ellen.Launcher.UI.Xaml.Behavior"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxdc="using:Ellen.Launcher.UI.Xaml.Data.Converter"
    xmlns:shuxdcs="using:Ellen.Launcher.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shuxv="using:Ellen.Launcher.UI.Xaml.View"
    xmlns:shuxvp="using:Ellen.Launcher.UI.Xaml.View.Page"
    xmlns:shvm="using:Ellen.Launcher.ViewModel"
    xmlns:sshuxcc="using:Ellen.Launcher.UI.Xaml.Control.Card"
    xmlns:tControls="using:CommunityToolkit.WinUI.Controls"
    d:DataContext="{d:DesignInstance Type=shvm:MainViewModel}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <UserControl.Resources>
        <!--  ReSharper disable Xaml.RedundantResource  -->
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0,1,0,0</Thickness>
        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
        <!--  ReSharper restore Xaml.RedundantResource  -->
        <shuxdcs:BackdropTypeToOpacityConverter x:Key="BackdropTypeToOpacityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="{Binding AppOptions.BackdropType.Value, Converter={StaticResource BackdropTypeToOpacityConverter}, Mode=OneWay}">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:1"/>
            </Border.OpacityTransition>
        </Border>

        <Image
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            Stretch="UniformToFill"
            UseLayoutRounding="False">
            <mxi:Interaction.Behaviors>
                <shuxb:ServiceRecipientBackgroundImagePresenterBehavior x:Name="BackgroundImageRecipient"/>
                <shuxb:PeriodicInvokeCommandOrOnActualThemeChangedBehavior Command="{x:Bind BackgroundImageRecipient.UpdateBackgroundCommand}" Period="0:5:0"/>
            </mxi:Interaction.Behaviors>
        </Image>

        <MediaPlayerElement
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            Stretch="UniformToFill"
            UseLayoutRounding="False">
            <mxi:Interaction.Behaviors>
                <shuxb:ServiceRecipientMediaPlayerElementPresenterBehavior x:Name="MediaPlayerElementRecipient"/>
                <shuxb:PeriodicInvokeCommandOrOnActualThemeChangedBehavior Command="{x:Bind MediaPlayerElementRecipient.UpdateMediaPlayerElementCommand}" Period="0:5:0"/>
            </mxi:Interaction.Behaviors>
        </MediaPlayerElement>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="TitleBar"
                Title="{Binding Title}"
                Grid.Row="0"
                x:FieldModifier="Public"
                IsBackButtonVisible="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
                IsPaneToggleButtonVisible="True">
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarCompactHeight">44</x:Double>
                    <x:Double x:Key="TitleBarExpandedHeight">44</x:Double>
                    <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                </TitleBar.Resources>
                <mxi:Interaction.Behaviors>
                    <shuxb:ServiceRecipientTitleBarBehavior/>
                </mxi:Interaction.Behaviors>
                <TitleBar.RightHeader>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        Orientation="Horizontal"
                        Spacing="6">

                        <Button
                            Padding="6"
                            Command="{Binding InvertAppThemeCommand}"
                            Content="[Dev] Invert Theme"
                            Style="{ThemeResource SettingButtonStyle}"
                            Visibility="{Binding IsDebug}"/>

                        <Button
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            PointerEntered="OnBackgroundActivityButtonPointerEntered"
                            PointerExited="OnBackgroundActivityButtonPointerExited"
                            Style="{ThemeResource SettingButtonStyle}">
                            <Button.Resources>
                                <SineEase x:Key="EasingFunction" EasingMode="EaseInOut"/>
                                <Storyboard x:Name="FocusStoryBoard">
                                    <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                        <EasingColorKeyFrame
                                            EasingFunction="{StaticResource EasingFunction}"
                                            KeyTime="0:0:0"
                                            Value="{ThemeResource ControlFillColorTransparent}"/>
                                        <EasingColorKeyFrame
                                            EasingFunction="{StaticResource EasingFunction}"
                                            KeyTime="0:0:0.5"
                                            Value="{ThemeResource SystemFillColorCautionBackground}"/>
                                        <EasingColorKeyFrame
                                            EasingFunction="{StaticResource EasingFunction}"
                                            KeyTime="0:0:1"
                                            Value="{ThemeResource ControlFillColorTransparent}"/>
                                        <EasingColorKeyFrame
                                            EasingFunction="{StaticResource EasingFunction}"
                                            KeyTime="0:0:1.5"
                                            Value="{ThemeResource SystemFillColorCautionBackground}"/>
                                        <EasingColorKeyFrame
                                            EasingFunction="{StaticResource EasingFunction}"
                                            KeyTime="0:0:2"
                                            Value="{ThemeResource ControlFillColorTransparent}"/>
                                    </ColorAnimationUsingKeyFrames>
                                </Storyboard>
                            </Button.Resources>
                            <Button.Content>
                                <Border Padding="16,6">
                                    <Border.Background>
                                        <SolidColorBrush Color="{ThemeResource ControlFillColorTransparent}"/>
                                    </Border.Background>
                                    <mxi:Interaction.Behaviors>
                                        <shuxb:FocusAnimationBehavior Storyboard="{StaticResource FocusStoryBoard}" Watch="{Binding BackgroundActivityOptions.MetadataInitialization.NotifyToken}"/>
                                        <shuxb:FocusAnimationBehavior Storyboard="{StaticResource FocusStoryBoard}" Watch="{Binding BackgroundActivityOptions.FullTrustInitialization.NotifyToken}"/>
                                    </mxi:Interaction.Behaviors>
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <ProgressRing
                                                Width="16"
                                                Height="16"
                                                IsIndeterminate="{Binding BackgroundActivityOptions.MetadataInitialization.IsIndeterminate, Mode=OneWay}"
                                                Visibility="{Binding BackgroundActivityOptions.MetadataInitialization.HasProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Value="{Binding BackgroundActivityOptions.MetadataInitialization.ProgressValue, Mode=OneWay}"/>
                                            <InfoBadge
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#C42B1C"
                                                Visibility="{Binding BackgroundActivityOptions.MetadataInitialization.IsFaulted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <InfoBadge.IconSource>
                                                    <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF13C;"/>
                                                </InfoBadge.IconSource>
                                            </InfoBadge>
                                            <InfoBadge
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SuccessIconInfoBadgeStyle}"
                                                Visibility="{Binding BackgroundActivityOptions.MetadataInitialization.IsCompletedSuccessfully, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{shuxm:ResourceString Name=UIViewMainTitleBarBackgroundActivityAction}"/>

                                        <tControls:SwitchPresenter
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TargetType="x:Boolean"
                                            Value="{Binding IsFlyoutOpen, Mode=OneWay}">
                                            <tControls:Case Value="True">
                                                <AnimatedIcon
                                                    x:Name="OpenedChevronAnimatedIcon"
                                                    Width="16"
                                                    Height="16">
                                                    <AnimatedIcon.Source>
                                                        <animatedvisuals:AnimatedChevronUpDownSmallVisualSource/>
                                                    </AnimatedIcon.Source>
                                                    <AnimatedIcon.FallbackIconSource>
                                                        <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70D;"/>
                                                    </AnimatedIcon.FallbackIconSource>
                                                </AnimatedIcon>
                                            </tControls:Case>
                                            <tControls:Case Value="False">
                                                <AnimatedIcon
                                                    x:Name="ClosedChevronAnimatedIcon"
                                                    Width="16"
                                                    Height="16">
                                                    <AnimatedIcon.Source>
                                                        <animatedvisuals:AnimatedChevronDownSmallVisualSource/>
                                                    </AnimatedIcon.Source>
                                                    <AnimatedIcon.FallbackIconSource>
                                                        <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70E;"/>
                                                    </AnimatedIcon.FallbackIconSource>
                                                </AnimatedIcon>
                                            </tControls:Case>
                                        </tControls:SwitchPresenter>
                                    </Grid>
                                </Border>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout
                                    shuxb:FlyoutOpenStateBinding.IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
                                    shuxb:FlyoutOpenStateBinding.IsTrackingEnabled="True"
                                    shuxb:FlyoutOpenStateBinding.SwitchDelayMilliseconds="120"
                                    FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding8Style}"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="True">
                                    <StackPanel
                                        Width="320"
                                        DataContext="{Binding BackgroundActivityOptions}"
                                        Spacing="4">
                                        <sshuxcc:CardProgressBar
                                            MinHeight="58"
                                            Description="{Binding MetadataInitialization.Description}"
                                            Header="{Binding MetadataInitialization.Title}"
                                            IsIndeterminate="{Binding MetadataInitialization.IsIndeterminate}"
                                            Maximum="1"
                                            ProgressForeground="{ThemeResource SystemControlForegroundAccentBrush}"
                                            Style="{ThemeResource CompactCardProgressBarStyle}"
                                            Value="{Binding MetadataInitialization.ProgressValue}"/>
                                        <sshuxcc:CardProgressBar
                                            MinHeight="58"
                                            Description="{Binding FullTrustInitialization.Description}"
                                            Header="{Binding FullTrustInitialization.Title}"
                                            IsIndeterminate="{Binding FullTrustInitialization.IsIndeterminate}"
                                            Maximum="1"
                                            ProgressForeground="{ThemeResource SystemControlForegroundAccentBrush}"
                                            Style="{ThemeResource CompactCardProgressBarStyle}"
                                            Value="{Binding FullTrustInitialization.ProgressValue}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </TitleBar.RightHeader>
            </TitleBar>

            <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
            <NavigationView
                Grid.Row="1"
                Margin="0,0,0,0"
                shuxc:NavigationViewHelper.PaneCornerRadius="0"
                CompactPaneLength="45"
                IsBackButtonVisible="Collapsed"
                IsEnabled="{Binding ElementName=ContentFrame, Path=Content.DataContext.IsInitialized, Mode=OneWay}"
                IsPaneOpen="True"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                OpenPaneLength="205"
                PaneDisplayMode="Auto"
                UseLayoutRounding="False">
                <mxi:Interaction.Behaviors>
                    <shuxb:ServiceRecipientNavigationViewBehavior/>
                </mxi:Interaction.Behaviors>
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:AnnouncementPage"
                        Content="{shuxm:ResourceString Name=ViewAnnouncementHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/Announcement.png}"/>
                    <NavigationViewItemHeader Content="{shuxm:ResourceString Name=ViewToolHeader}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:GachaLogPage"
                        Content="{shuxm:ResourceString Name=ViewGachaLogHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/GachaLog.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:AchievementPage"
                        Content="{shuxm:ResourceString Name=ViewAchievementHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/Achievement.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:DailyNotePage"
                        Content="{shuxm:ResourceString Name=ViewDailyNoteHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/DailyNote.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:AvatarPropertyPage"
                        Content="{shuxm:ResourceString Name=ViewAvatarPropertyHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/AvatarProperty.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:BackpackPage"
                        Content="{shuxm:ResourceString Name=ViewBackpackHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/Backpack.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:TarotCardPage"
                        Content="{shuxm:ResourceString Name=ViewTarotCardHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/TarotCard.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:CultivationPage"
                        Content="{shuxm:ResourceString Name=ViewCultivationHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/Cultivation.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:TeyvatMapPage"
                        Content="{shuxm:ResourceString Name=ViewTeyvatMapHeader}">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE707;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:HoyoFanTranslatePage"
                        Content="{shuxm:ResourceString Name=ViewHoyoFanTranslateHeader}">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE774;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemHeader Content="{shuxm:ResourceString Name=ViewPeriodHeader}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:SpiralAbyssRecordPage"
                        Content="{shuxm:ResourceString Name=ViewSpiralAbyssHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/SpiralAbyss.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:RoleCombatPage"
                        Content="{shuxm:ResourceString Name=ViewRoleCombatHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/RoleCombat.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:HardChallengePage"
                        Content="{shuxm:ResourceString Name=ViewHardChallengeHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/HardChallenge.png}"/>

                    <NavigationViewItemHeader Content="{shuxm:ResourceString Name=ViewDataHeader}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:WikiAvatarPage"
                        Content="{shuxm:ResourceString Name=ViewWikiAvatarHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/WikiAvatar.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:WikiWeaponPage"
                        Content="{shuxm:ResourceString Name=ViewWikiWeaponHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/WikiWeapon.png}"/>
                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:WikiMonsterPage"
                        Content="{shuxm:ResourceString Name=ViewWikiMonsterHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/WikiMonster.png}"/>

                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:FormulasPage"
                        Content="{shuxm:ResourceString Name=ViewFormulasHeader}">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="Segoe UI Emoji" Glyph="&#x1F9EE;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.PaneFooter>
                    <shuxv:UserView x:Name="UserView"/>
                </NavigationView.PaneFooter>

                <Frame
                    x:Name="ContentFrame"
                    x:FieldModifier="Public"
                    ContentTransitions="{StaticResource NavigationThemeTransitions}"/>
            </NavigationView>
        </Grid>

        <shuxv:InfoBarView Margin="0,44,0,0" VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
