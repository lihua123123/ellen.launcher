<UserControl
    x:Class="Ellen.Launcher.UI.Xaml.View.Card.SignInCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Ellen.Launcher.UI.Xaml.Behavior"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shvs="using:Ellen.Launcher.ViewModel.SignIn"
    Height="{ThemeResource HomeAdaptiveCardHeight}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DataContext="{d:DesignInstance shvs:SignInViewModelSlim}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Grid>
        <Grid
            Margin="12"
            RowSpacing="6"
            Visibility="{Binding IsInitialized, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewCardSignInTitle}"/>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Summary}"/>

                <Button
                    Grid.Column="2"
                    MinHeight="26"
                    Padding="8,2"
                    Command="{Binding SignAllCommand}"
                    Content="{shuxm:ResourceString Name=ViewCardSignInSignAll}"
                    IsEnabled="{Binding CanSignAll}"
                    Style="{StaticResource AccentButtonStyle}"/>
            </Grid>

            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.7"
                Text="{shuxm:ResourceString Name=ViewCardSignInEmpty}"
                Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityRevertConverter}}"/>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shvs:SignInEntry">
                            <Grid Margin="0,2" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Attribution}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding TotalSignDayText}"/>
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{shuxm:ResourceString Name=ViewCardSignInSigned}"
                                    Visibility="{Binding IsSign, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <shuxc:Loading IsLoading="{Binding IsInitialized, Converter={StaticResource BoolNegationConverter}}" Style="{ThemeResource DefaultLoadingCardStyle}"/>
    </Grid>
</UserControl>
