<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.HardChallengePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwcont="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Ellen.Launcher.UI.Xaml.Behavior"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxcc="using:Ellen.Launcher.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Ellen.Launcher.UI.Xaml.Control.Image"
    xmlns:shuxcp="using:Ellen.Launcher.UI.Xaml.Control.Panel"
    xmlns:shuxct="using:Ellen.Launcher.UI.Xaml.Control.TextBlock"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shme="using:Ellen.Launcher.Model.Endgame"
    xmlns:shvh="using:Ellen.Launcher.ViewModel.HardChallenge"
    d:DataContext="{d:DesignInstance shvh:HardChallengeViewModel}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <cwconv:BoolToObjectConverter
            x:Key="BoolToOpacityConverter"
            FalseValue="0.4"
            TrueValue="1"/>

        <!--
            机制文字对齐 ellen-wiki 的排版：
            以小标题行用蓝底 + 圆点，正文行用浅底 + 描边，行内 **加粗** / `专有名词` / $公式$ 保留样式。
        -->
        <DataTemplate x:Key="HardChallengeGuideLineTemplate" x:DataType="shme:HardChallengeGuideLine">
            <Grid Margin="0,0,0,8">
                <Border
                    Padding="8,9"
                    Background="#244A89DC"
                    BorderBrush="#4D4A89DC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsHeading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Text}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border
                    Padding="10,8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsHeading, Converter={StaticResource BoolToVisibilityRevertConverter}}">
                    <TextBlock
                        shuxc:GuideRichText.Source="{Binding Raw}"
                        TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HardChallengeGuideSectionTemplate" x:DataType="shme:HardChallengeGuideSection">
            <StackPanel Margin="0,8,0,0">
                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{Binding Title}"
                    Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl ItemTemplate="{StaticResource HardChallengeGuideLineTemplate}" ItemsSource="{Binding Lines}"/>
            </StackPanel>
        </DataTemplate>

        <!--
            单个 Boss 的卡片：上方是 Boss 头图 / 名称 / N5·N6 血量，
            下方依次是战斗用时、挑战阵容、最强一击与最高总伤害（无记录时显示占位）、机制，
            卡片上的按钮用浮出层展示「介绍 / 背景」。
        -->
        <DataTemplate x:Key="HardChallengeBossCardTemplate" x:DataType="shvh:ChallengeView">
            <Grid
                Padding="16"
                RowSpacing="12"
                Style="{ThemeResource GridShimmerStyle}"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Width="136"
                        Height="136"
                        VerticalAlignment="Top">
                        <Image
                            Source="{Binding GuideImageUri}"
                            Stretch="UniformToFill"
                            Visibility="{Binding HasGuideImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxci:CachedImage
                            Source="{Binding Monster.Icon}"
                            Stretch="UniformToFill"
                            Visibility="{Binding ShowRemoteImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Grid
                            Style="{ThemeResource GridShimmerStyle}"
                            Visibility="{Binding ShowImagePlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.6"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageHardChallengeGuideImageMissing}"
                                TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="3"
                        VerticalAlignment="Top">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{Binding DisplayName}"
                            TextWrapping="Wrap"/>
                        <TextBlock
                            Opacity="0.75"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{Binding SecondaryName}"
                            TextWrapping="Wrap"/>
                        <TextBlock
                            Opacity="0.6"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding Monster.Level}"
                            TextWrapping="Wrap"/>
                        <StackPanel Spacing="2" Visibility="{Binding HasHp, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Opacity="0.7"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="N5"/>
                                <TextBlock
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{Binding HpN5}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Opacity="0.7"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="N6"/>
                                <TextBlock
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{Binding HpN6}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ItemsControl
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    ItemsPanel="{ThemeResource WrapPanelSpacing4Template}"
                    ItemsSource="{Binding Monster.Tags}"
                    Visibility="{Binding HasMonster, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="6,4"
                                CornerRadius="12"
                                Style="{ThemeResource BorderShimmerStyle}">
                                <shuxct:DescriptionRichTextBlock Margin="0,-1,0,0" Description="{Binding Description}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel
                    Grid.Row="2"
                    Spacing="8"
                    Visibility="{Binding ShowRecord, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Padding="8" Style="{ThemeResource GridShimmerStyle}">
                        <TextBlock Text="{shuxm:ResourceString Name=ViewPageHardChallengeTime}"/>
                        <TextBlock HorizontalTextAlignment="Right" Text="{Binding FormattedSeconds}"/>
                    </Grid>

                    <!--  左：挑战阵容；右：上=最强一击，下=最高总伤害  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl
                            Grid.Column="0"
                            MaxWidth="420"
                            VerticalAlignment="Top"
                            ItemTemplate="{StaticResource AvatarViewInTeamTemplate}"
                            ItemsPanel="{ThemeResource HorizontalStackPanelSpacing4Template}"
                            ItemsSource="{Binding Avatars}"/>

                        <ItemsControl
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            ItemsPanel="{StaticResource StackPanelSpacing8Template}"
                            ItemsSource="{Binding BestAvatars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" Style="{ThemeResource GridShimmerStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <shuxci:CachedImage
                                                Width="36"
                                                Height="36"
                                                Margin="-8,-8,0,0"
                                                Source="{Binding SideIcon}"/>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Type}"/>
                                        </StackPanel>

                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{Binding Value}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    Opacity="0.6"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewPageHardChallengeBossNoRecord}"
                    Visibility="{Binding ShowRecordPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid
                    Grid.Row="3"
                    RowSpacing="4"
                    Visibility="{Binding HasMechanism, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageHardChallengeGuideMechanism}"/>
                    <ItemsControl
                        Grid.Row="1"
                        ItemTemplate="{StaticResource HardChallengeGuideLineTemplate}"
                        ItemsSource="{Binding Mechanism.Lines}"/>
                </Grid>

                <Button
                    Grid.Row="4"
                    HorizontalAlignment="Left"
                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE946;"/>
                            <TextBlock Text="{shuxm:ResourceString Name=ViewPageHardChallengeBossDetail}"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <ScrollViewer
                                MaxHeight="520"
                                MaxWidth="420">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{Binding DisplayName}"
                                        TextWrapping="Wrap"/>
                                    <ItemsControl ItemTemplate="{StaticResource HardChallengeGuideSectionTemplate}" ItemsSource="{Binding DetailSections}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HardChallengeListTemplate" x:DataType="shvh:HardChallengeView">
            <StackPanel Margin="0,6,0,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Schedule}"/>
                    <TextBlock
                        Grid.Column="1"
                        Opacity="0.8"
                        Text="{Binding MaxDifficulty}"/>
                </Grid>
                <MenuFlyoutSeparator Margin="3,2"/>
                <TextBlock
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding FormattedTime}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AvatarViewTemplate" x:DataType="shvh:AvatarView">
            <shuxcc:VerticalCard>
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon Icon="{Binding Icon}" Quality="{Binding Quality}"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock Text="{Binding Name}"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>

        <DataTemplate x:Key="AvatarViewInTeamTemplate" x:DataType="shvh:AvatarView">
            <shuxcc:VerticalCard>
                <shuxcc:VerticalCard.Top>
                    <Grid>
                        <shuxc:ItemIcon
                            Width="56"
                            Height="56"
                            Icon="{Binding Icon}"
                            Quality="{Binding Quality}"/>
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#80000000"
                            CornerRadius="{ThemeResource ControlCornerRadiusTopRightAndBottomLeft}">
                            <TextBlock
                                Margin="6,2"
                                Foreground="#FFFFFFFF"
                                Text="{Binding ActivatedConstellationCount}"/>
                        </Border>
                    </Grid>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        MaxWidth="76"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>

        <DataTemplate x:Key="BlingAvatarViewTemplate" x:DataType="shvh:AvatarBling">
            <shuxcc:VerticalCard>
                <shuxcc:VerticalCard.Top>
                    <Grid>
                        <shuxc:ItemIcon
                            Width="48"
                            Height="48"
                            Icon="{Binding Icon}"
                            Opacity="{Binding IsPlus, Converter={StaticResource BoolToOpacityConverter}}"
                            Quality="{Binding Quality}"/>
                        <Image
                            Width="12"
                            Height="12"
                            Margin="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Source="ms-appx:///Resource/Icon/UI_IconKira.png"
                            Visibility="{Binding IsPlus}"/>
                    </Grid>

                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        MaxWidth="44"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Name}"
                        TextWrapping="NoWrap"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="BossCardPanelTemplate">
            <shuxcp:UniformPanel
                ColumnSpacing="16"
                MinItemWidth="520"
                RowSpacing="16"
                StretchItemHeight="True"/>
        </ItemsPanelTemplate>
    </Page.Resources>

    <Pivot Style="{ThemeResource CardPivotStyle}">
        <Pivot.RightHeader>
            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                <AppBarButton
                    Command="{Binding RefreshCommand}"
                    Icon="{shuxm:FontIcon Glyph=&#xE72C;}"
                    Label="{shuxm:ResourceString Name=ViewSpiralAbyssRefresh}"/>
            </CommandBar>
        </Pivot.RightHeader>

        <PivotItem Header="{shuxm:ResourceString Name=ViewSpiralAbyssDetail}">
            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                    <SplitView
                        DisplayMode="Inline"
                        IsPaneOpen="True"
                        OpenPaneLength="248"
                        PaneBackground="Transparent">
                        <SplitView.Pane>
                            <ListView
                                Padding="{ThemeResource ListViewInSplitPanePadding}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                ItemTemplate="{StaticResource HardChallengeListTemplate}"
                                ItemsSource="{Binding HardChallengeEntries}"
                                SelectedItem="{Binding HardChallengeEntries.CurrentItem, Mode=TwoWay}"/>
                        </SplitView.Pane>
                        <SplitView.Content>
                            <ScrollViewer>
                                <StackPanel Padding="16" Spacing="16">

                                    <!--  个人挑战记录：通关角色 → 挑战项目 → 三个 Boss 卡片  -->
                                    <StackPanel
                                        DataContext="{Binding HardChallengeEntries.CurrentItem}"
                                        Spacing="16"
                                        Visibility="{Binding Converter={StaticResource EmptyObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <ItemsControl
                                            ItemTemplate="{StaticResource BlingAvatarViewTemplate}"
                                            ItemsPanel="{ThemeResource WrapPanelSpacing4Template}"
                                            ItemsSource="{Binding BlingAvatars}"
                                            Visibility="{Binding BlingAvatars, Converter={StaticResource EmptyCollectionToVisibilityConverter}}"/>

                                        <cwcont:Segmented
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding DataEntries}"
                                            SelectedItem="{Binding DataEntries.CurrentItem, Mode=TwoWay}"
                                            Visibility="{Binding DataEntries, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">
                                            <cwcont:Segmented.ItemTemplate>
                                                <DataTemplate x:DataType="shvh:DataEntryView">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </cwcont:Segmented.ItemTemplate>
                                        </cwcont:Segmented>

                                        <ContentControl
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Content="{Binding DataEntries.CurrentItem}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="shvh:DataEntryView">
                                                    <Grid RowSpacing="16">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid
                                                            Padding="8"
                                                            ColumnSpacing="8"
                                                            Style="{ThemeResource GridShimmerStyle}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto"/>
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image
                                                                Grid.Column="0"
                                                                Width="36"
                                                                Height="36"
                                                                Source="{Binding DifficultyIcon}"/>
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding Difficulty}"/>
                                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding FormattedSeconds}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            ItemTemplate="{StaticResource HardChallengeBossCardTemplate}"
                                                            ItemsPanel="{StaticResource BossCardPanelTemplate}"
                                                            ItemsSource="{Binding Challenges}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>

                                    <!--  没有个人记录（未登录 / 该期没有战绩）：直接展示该期对应版本的 Boss 卡片，与有记录的页面保持一致  -->
                                    <ItemsControl
                                        ItemTemplate="{StaticResource HardChallengeBossCardTemplate}"
                                        ItemsPanel="{StaticResource BossCardPanelTemplate}"
                                        ItemsSource="{Binding GuideCards}"
                                        Visibility="{Binding IsGuideOnlyMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </SplitView.Content>
                    </SplitView>
                </Border>
            </Border>
        </PivotItem>
    </Pivot>
</shuxc:ScopedPage>
