<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.CultivationPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwcont="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxca="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shux="using:Ellen.Launcher.UI.Xaml"
    xmlns:shuxb="using:Ellen.Launcher.UI.Xaml.Behavior"
    xmlns:shuxba="using:Ellen.Launcher.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxca="using:Ellen.Launcher.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Ellen.Launcher.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Ellen.Launcher.UI.Xaml.Control.Image"
    xmlns:shuxcpd="using:Ellen.Launcher.UI.Xaml.Control.Panel.DataTable"
    xmlns:shuxdc="using:Ellen.Launcher.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shvcu="using:Ellen.Launcher.ViewModel.Cultivation"
    d:DataContext="{d:DesignInstance shvcu:CultivationViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushSelector"
                        FalseValue="{StaticResource SolidBackgroundFillColorTransparentBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToStatisticsBrushSelector"
                        FalseValue="{StaticResource CardBackgroundFillColorDefaultBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushSelector"
                        FalseValue="{StaticResource SolidBackgroundFillColorTransparentBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToStatisticsBrushSelector"
                        FalseValue="{StaticResource CardBackgroundFillColorDefaultBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <shux:BindingProxy x:Key="BindingProxy" DataContext="{Binding}"/>

            <DataTemplate x:Key="FlyoutSkillTemplate">
                <Border Margin="0,2,0,0" Style="{StaticResource BorderCardStyle}">
                    <Grid Margin="8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <shuxci:CachedImage
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            ShowAsMonoChrome="True"
                            Source="{Binding Icon}"/>
                        <TextBlock
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"/>
                        <NumberBox
                            Grid.Column="3"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Maximum="{Binding LevelMax}"
                            Minimum="{Binding LevelMin}"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                        <FontIcon
                            Grid.Column="4"
                            Margin="4,0"
                            FontSize="12"
                            Glyph="&#xEBE7;"/>
                        <NumberBox
                            Grid.Column="5"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Maximum="{Binding LevelMax}"
                            Minimum="{Binding LevelCurrent, Mode=OneWay}"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding LevelTarget, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <Flyout
                x:Key="CultivateEntryFlyout"
                Placement="RightEdgeAlignedTop"
                ShouldConstrainToRootBounds="False">
                <Flyout.FlyoutPresenterStyle>
                    <Style BasedOn="{StaticResource FlyoutPresenterPadding8Style}" TargetType="FlyoutPresenter">
                        <Setter Property="MaxWidth" Value="Infinity"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!--  Avatar section  -->
                    <StackPanel Grid.Row="0" Visibility="{Binding Avatar, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                        <Grid
                            Padding="8"
                            ColumnSpacing="6"
                            DataContext="{Binding Avatar}"
                            Style="{ThemeResource GridCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Icon="{Binding Icon}"
                                Quality="{Binding Quality}"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"/>
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding IsPromotionAvailable}">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                    IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                            </StackPanel>
                            <NumberBox
                                Grid.Column="3"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{Binding LevelMax}"
                                Minimum="{Binding LevelMin}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                            <FontIcon
                                Grid.Column="4"
                                Margin="4,0"
                                FontSize="12"
                                Glyph="&#xEBE7;"/>
                            <NumberBox
                                Grid.Column="5"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{Binding LevelMax}"
                                Minimum="{Binding LevelCurrent, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding LevelTarget, Mode=TwoWay}"/>
                        </Grid>

                        <ItemsControl ItemTemplate="{StaticResource FlyoutSkillTemplate}" ItemsSource="{Binding Avatar.Skills}"/>
                    </StackPanel>

                    <!--  Weapon section  -->
                    <StackPanel Grid.Row="1" Visibility="{Binding Weapon, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                        <Grid
                            Padding="8"
                            ColumnSpacing="6"
                            DataContext="{Binding Weapon}"
                            Style="{ThemeResource GridCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Icon="{Binding Icon}"
                                Quality="{Binding Quality}"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"/>
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding IsPromotionAvailable}">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                    IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                            </StackPanel>
                            <NumberBox
                                Grid.Column="3"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{Binding LevelMax}"
                                Minimum="{Binding LevelMin}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                            <FontIcon
                                Grid.Column="4"
                                Margin="4,0"
                                FontSize="12"
                                Glyph="&#xEBE7;"/>
                            <NumberBox
                                Grid.Column="5"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{Binding LevelMax}"
                                Minimum="{Binding LevelCurrent, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding LevelTarget, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!--  Action buttons  -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Path=DataContext.ModifyEntryCommand, Source={StaticResource BindingProxy}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource AccentButtonStyle}">
                            <mxi:Interaction.Behaviors>
                                <mxi:EventTriggerBehavior EventName="Click">
                                    <shuxba:HideAttachedFlyoutAction/>
                                </mxi:EventTriggerBehavior>
                            </mxi:Interaction.Behaviors>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="14" Glyph="&#xE73E;"/>
                                <TextBlock Text="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"/>
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource DefaultButtonStyle}">
                            <mxi:Interaction.Behaviors>
                                <mxi:EventTriggerBehavior EventName="Click">
                                    <shuxba:HideAttachedFlyoutAction/>
                                </mxi:EventTriggerBehavior>
                            </mxi:Interaction.Behaviors>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="14" Glyph="&#xE711;"/>
                                <TextBlock Text="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Flyout>

            <cwconv:BoolToObjectConverter x:Key="BoolToOpacityConverter">
                <cwconv:BoolToObjectConverter.TrueValue>
                    <x:Double>0.4</x:Double>
                </cwconv:BoolToObjectConverter.TrueValue>
                <cwconv:BoolToObjectConverter.FalseValue>
                    <x:Double>1</x:Double>
                </cwconv:BoolToObjectConverter.FalseValue>
            </cwconv:BoolToObjectConverter>

            <cwconv:BoolToObjectConverter
                x:Key="BoolToStyleSelector"
                FalseValue="{StaticResource BodyTextBlockStyle}"
                TrueValue="{StaticResource BaseTextBlockStyle}"/>

            <shuxdc:SpecificStringToVisibilityConverter x:Key="MaterialListSelectedItemIsEntryViewConverter" Value="Entry"/>
            <shuxdc:SpecificStringToVisibilityConverter x:Key="MaterialListSelectedItemIsStatisticsViewConverter" Value="Statistics"/>
            <shuxdc:BoolToAnimatedIconStateConverter x:Key="BoolToAnimatedIconStateConverter"/>

            <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
                <Grid Height="22" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Grid.Column="0"
                        Width="12"
                        Height="12"
                        Margin="1,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding Quality}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <BitmapIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-3,2,7,0"
                        ShowAsMonochrome="True"
                        UriSource="{Binding PackageIconUri, Mode=OneWay}"
                        Visibility="{Binding PackageIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-3,2,7,0"
                        ShowAsMonoChrome="True"
                        Source="{Binding IconUri, Mode=OneWay}"
                        Visibility="{Binding IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-4,-2,8,2"
                        Source="{Binding SideIconUri, Mode=OneWay}"
                        Visibility="{Binding SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                    <TextBlock
                        Grid.Column="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Text="{Binding Value}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryItemTemplate" x:DataType="shvcu:CultivateItemView">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <shuxc:ItemIcon
                            Width="32"
                            Height="32"
                            Icon="{Binding Inner.Icon, Converter={StaticResource ItemIconConverter}}"
                            Opacity="{Binding IsFinished, Converter={StaticResource BoolToOpacityConverter}}"
                            Quality="{Binding Inner.RankLevel}"/>

                        <AnimatedIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            State="{Binding IsFinished, Converter={StaticResource BoolToAnimatedIconStateConverter}}">
                            <muxca:AnimatedAcceptVisualSource/>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource FontSize="24" Glyph="&#xE73E;"/>
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Grid>
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <Button
                        Grid.Column="1"
                        Height="32"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{Binding IsToday, Converter={ThemeResource BoolToBrushSelector}}"
                        Command="{Binding Path=DataContext.FinishStateCommand, Source={StaticResource BindingProxy}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource ButtonRevealStyle}">
                        <Grid Opacity="{Binding IsFinished, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Style="{Binding IsToday, Converter={StaticResource BoolToStyleSelector}}"
                                Text="{Binding Inner.Name}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{Binding IsToday, Converter={StaticResource BoolToStyleSelector}}"
                                Text="{Binding Entity.Count}"/>
                        </Grid>
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryTemplate" x:DataType="shvcu:CultivateEntryView">
                <!--  与背包物品卡片同一套口径：不做逐卡片的亚克力背景与 ThemeShadow。
                      亚克力是合成层的背景滤镜，ThemeShadow 也是独立合成层，两者都在虚拟化列表里
                      逐卡片创建，滚动时每帧都要重新采样背景——这是本页比背包页卡顿的主因。
                      这里改用纯色 GridCardStyle，圆角/边框与原样式一致，只是不再透背景。  -->
                <Border>
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="PointerPressed">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="CultivateEntryFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <!--  卡片高度固定：这是条目列表能真正虚拟化的前提。
                          错落布局（UniformStaggeredLayout）为了算列高必须把每个条目都量一遍，
                          也就是把全部 32 张卡、约 320 个 ItemIcon 一次性实现（实测每卡 ~45ms，
                          累计 2s 以上）；固定高度后换成 UniformGridLayout，只实现视口内的约 8 张。
                          材料多于可视区时在卡片内滚动，不再撑高卡片。  -->
                    <Grid Height="380" Style="{ThemeResource GridCardStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Width="52"
                                Height="52"
                                Icon="{Binding Icon}"
                                Quality="{Binding Quality}"/>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Description}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                                <Button
                                    Width="48"
                                    Height="48"
                                    Margin="8,0,0,0"
                                    Background="Transparent"
                                    Command="{Binding Path=DataContext.RemoveEntryCommand, Source={StaticResource BindingProxy}}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE74D;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Style="{StaticResource ButtonRevealStyle}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageCultivationRemoveEntry}"/>
                            </StackPanel>
                        </Grid>
                        <MenuFlyoutSeparator Grid.Row="1"/>
                        <ScrollViewer
                            Grid.Row="2"
                            Margin="0,2,0,0"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                Margin="8,0,8,8"
                                ItemTemplate="{ThemeResource CultivateEntryItemTemplate}"
                                ItemsSource="{Binding Items}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="StatisticsItemTemplate" x:DataType="shvcu:StatisticsCultivateItem">
                <shuxcc:HorizontalCard Background="{Binding IsToday, Converter={ThemeResource BoolToStatisticsBrushSelector}}">
                    <shuxcc:HorizontalCard.Left>
                        <Grid Grid.Column="0">
                            <shuxc:ItemIcon
                                Width="40"
                                Height="40"
                                Icon="{Binding Inner.Icon, Converter={StaticResource ItemIconConverter}}"
                                Opacity="{Binding IsFinished, Converter={StaticResource BoolToOpacityConverter}}"
                                Quality="{Binding Inner.RankLevel}"/>
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Glyph="&#xE73E;"
                                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Left>
                    <shuxcc:HorizontalCard.Right>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Inner.Name}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding FormattedCount}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Right>
                </shuxcc:HorizontalCard>
            </DataTemplate>

            <DataTemplate x:Key="InventoryItemTemplate" x:DataType="shvcu:InventoryItemView">
                <Button
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="{x:Null}"
                    BorderThickness="0">
                    <shuxcc:HorizontalCard Width="300">
                        <shuxcc:HorizontalCard.Left>
                            <shuxc:ItemIcon
                                Width="40"
                                Height="40"
                                Icon="{Binding Inner.Icon, Converter={StaticResource ItemIconConverter}}"
                                Quality="{Binding Inner.RankLevel}"/>
                        </shuxcc:HorizontalCard.Left>
                        <shuxcc:HorizontalCard.Right>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Inner.Name}"
                                    TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Count, Mode=OneWay}"/>
                            </Grid>
                        </shuxcc:HorizontalCard.Right>
                    </shuxcc:HorizontalCard>
                    <Button.Flyout>
                        <Flyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding Inner.Name}"/>
                                <NumberBox
                                    Grid.Row="1"
                                    MinWidth="160"
                                    Margin="0,16,0,0"
                                    Maximum="4294967295"
                                    Minimum="0"
                                    Value="{Binding Count, Mode=TwoWay}"/>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <shuxc:StandardView HideCondition="{Binding IsInitialized, Converter={StaticResource BoolNegationConverter}}" ShowCondition="{Binding Projects.Count, Converter={StaticResource Int32ToBoolConverter}}">
        <shuxc:StandardView.EmptyContent>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border
                    MinWidth="480"
                    Padding="16"
                    Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel>
                        <shuxci:CachedImage
                            Width="120"
                            Height="120"
                            Source="{StaticResource UI_EmotionIcon293}"/>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageCultivationAddProjectContinue}"/>
                        <StackPanel Margin="0,24,0,0">
                            <cwcont:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationAddProjectAction}"
                                Command="{Binding AddProjectCommand}"
                                Description="{shuxm:ResourceString Name=ViewPageCultivationAddProjectDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageCultivationAddProject}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE710;}"
                                IsClickEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </shuxc:StandardView.EmptyContent>
        <!--  SelectedIndex 回传视图模型：Pivot 会 measure 所有 PivotItem，只有让模型知道当前可见的是哪一页，
              才能像背包页那样「只发布可见标签页的数据」，避免隐藏页的列表也去实例化容器、拉图片。  -->
        <Pivot SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Style="{ThemeResource CardPivotStyle}">
            <Pivot.RightHeader>
                <CommandBar DefaultLabelPosition="Right">
                    <AppBarElementContainer>
                        <shuxc:SizeRestrictedContentControl Margin="6,6,6,6">
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Projects}"
                                SelectedItem="{Binding Projects.CurrentItem, Mode=TwoWay}"
                                Style="{ThemeResource CommandBarComboBoxStyle}"/>
                        </shuxc:SizeRestrictedContentControl>
                    </AppBarElementContainer>
                    <AppBarButton
                        Command="{Binding ClearInventoryCommand}"
                        CommandParameter="{Binding Projects.CurrentItem, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE894;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationClearInventory}"/>
                    <AppBarButton Icon="{shuxm:FontIcon Glyph=&#xE895;}" Label="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventory}">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Command="{Binding RefreshInventoryByEmbeddedYaeCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE7FC;}"
                                    Text="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventoryByEmbeddedYae}"/>
                                <MenuFlyoutItem
                                    Command="{Binding RefreshInventoryByBackpackArchiveCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    Text="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventoryByBackpackArchive}"/>
                                <MenuFlyoutItem
                                    Command="{Binding RefreshInventoryByCalculatorCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE8EF;}"
                                    Text="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventoryByCalculator}"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton
                        Command="{Binding SyncAvatarInfoByHoyolabGameRecordCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xE77B;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationSyncAvatarInfo}"/>
                    <AppBarButton
                        Command="{Binding AddProjectCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xE710;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationAddProject}"/>
                    <AppBarButton
                        Command="{Binding AddCustomMaterialCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xE8B7;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationAddCustomMaterialLabel}"/>
                    <AppBarButton
                        Command="{Binding RemoveProjectCommand}"
                        CommandParameter="{Binding Projects.CurrentItem, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE74D;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationRemoveProject}"/>
                </CommandBar>
            </Pivot.RightHeader>

            <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationMaterialList}">
                <shuxc:StandardView HideCondition="{Binding EntriesUpdating}" ShowCondition="{Binding CultivateEntries.Source.Count, Converter={StaticResource Int32ToBoolConverter}}">
                    <shuxc:StandardView.EmptyContent>
                        <Border
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                            <Border
                                MinWidth="480"
                                Padding="16"
                                Style="{ThemeResource AcrylicBorderCardStyle}">
                                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                                    <StackPanel.Resources>
                                        <!--  ReSharper disable Xaml.RedundantResource  -->
                                        <Thickness x:Key="SettingsCardPadding">16</Thickness>
                                        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                        <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                        <!--  ReSharper restore Xaml.RedundantResource  -->
                                    </StackPanel.Resources>
                                    <shuxci:CachedImage
                                        Height="120"
                                        Margin="0,0,0,16"
                                        Source="{StaticResource UI_EmotionIcon433}"/>
                                    <cwcont:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationNavigateAction}"
                                        Command="{Binding NavigateToPageCommand}"
                                        CommandParameter="Ellen.Launcher.UI.Xaml.View.Page.WikiAvatarPage"
                                        Description="{shuxm:ResourceString Name=ViewPageCultivationWikiAvatarDescription}"
                                        Header="{shuxm:ResourceString Name=ViewWikiAvatarHeader}"
                                        HeaderIcon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/WikiAvatar.png}"
                                        IsClickEnabled="True"/>
                                    <cwcont:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationNavigateAction}"
                                        Command="{Binding NavigateToPageCommand}"
                                        CommandParameter="Ellen.Launcher.UI.Xaml.View.Page.WikiWeaponPage"
                                        Description="{shuxm:ResourceString Name=ViewPageCultivationWikiWeaponDescription}"
                                        Header="{shuxm:ResourceString Name=ViewWikiWeaponHeader}"
                                        HeaderIcon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/WikiWeapon.png}"
                                        IsClickEnabled="True"/>
                                    <cwcont:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationNavigateAction}"
                                        Command="{Binding NavigateToPageCommand}"
                                        CommandParameter="Ellen.Launcher.UI.Xaml.View.Page.AvatarPropertyPage"
                                        Description="{shuxm:ResourceString Name=ViewPageCultivationAvatarPropertyDescription}"
                                        Header="{shuxm:ResourceString Name=ViewAvatarPropertyHeader}"
                                        HeaderIcon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/Cultivation.png}"
                                        IsClickEnabled="True"/>
                                    <cwcont:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationNavigateAction}"
                                        Command="{Binding AddCustomMaterialCommand}"
                                        Description="{shuxm:ResourceString Name=ViewPageCultivationAddCustomMaterialDescription}"
                                        Header="{shuxm:ResourceString Name=ViewPageCultivationAddCustomMaterialLabel}"
                                        HeaderIcon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Icon/UI_ItemIcon_201.png}"
                                        IsClickEnabled="True"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </shuxc:StandardView.EmptyContent>
                    <Pivot
                        x:Name="MaterialListPivot"
                        SelectedIndex="{Binding SelectedMaterialTabIndex, Mode=TwoWay}"
                        Style="{ThemeResource CardPivotStyle}">
                        <Pivot.RightHeader>
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarElementContainer>
                                    <shuxca:AutoSuggestTokenBox
                                        Width="600"
                                        Height="44"
                                        Margin="6,-2,6,6"
                                        HorizontalAlignment="Right"
                                        VerticalContentAlignment="Center"
                                        AvailableTokens="{Binding SearchData.AvailableTokens}"
                                        FilterCommand="{Binding FilterCommand}"
                                        ItemsSource="{Binding SearchData.FilterTokens, Mode=TwoWay}"
                                        MaximumTokens="5"
                                        PlaceholderText="筛选养成物品"
                                        QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                                        Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                                        SuggestedItemTemplate="{StaticResource TokenTemplate}"
                                        SuggestedItemsSource="{Binding SearchData.AvailableTokens.Values}"
                                        Text="{Binding SearchData.FilterToken, Mode=TwoWay}"
                                        TokenItemTemplate="{StaticResource TokenTemplate}"
                                        Visibility="{Binding ElementName=MaterialListPivot, Path=SelectedItem.Tag, Converter={StaticResource MaterialListSelectedItemIsEntryViewConverter}}"/>
                                </AppBarElementContainer>
                                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                                <AppBarToggleButton
                                    Command="{Binding RefreshStatisticsItemsCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE8D4;}"
                                    IsChecked="{Binding AutoSynthesisPreview, Mode=TwoWay}"
                                    Label="{shuxm:ResourceString Name=ViewPageCultivationMaterialListAutoSynthesisLabel}"
                                    Visibility="{Binding ElementName=MaterialListPivot, Path=SelectedItem.Tag, Converter={StaticResource MaterialListSelectedItemIsStatisticsViewConverter}}"/>
                                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                                <AppBarToggleButton
                                    Command="{Binding RefreshStatisticsItemsCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE8CB;}"
                                    IsChecked="{Binding IncompleteFirst, Mode=TwoWay}"
                                    Label="{shuxm:ResourceString Name=ViewPageCultivationMaterialListIncompleteFirstLabel}"
                                    Visibility="{Binding ElementName=MaterialListPivot, Path=SelectedItem.Tag, Converter={StaticResource MaterialListSelectedItemIsStatisticsViewConverter}}"/>
                                <AppBarButton Icon="{shuxm:FontIcon Glyph=&#xE946;}" Label="{shuxm:ResourceString Name=ViewPageCultivationMaterialListResinStatisticsLabel}">
                                    <AppBarButton.Flyout>
                                        <Flyout FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding0Style}" Placement="BottomEdgeAlignedRight">
                                            <StackPanel DataContext="{Binding ResinStatistics}">
                                                <Border
                                                    Padding="8"
                                                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Text="{shuxm:ResourceString Name=ViewPageCultivationMaterialListWorldLevelTitle}"/>
                                                        <shuxc:SizeRestrictedContentControl
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            AllowFocusOnInteraction="True">
                                                            <ComboBox
                                                                DisplayMemberPath="WorldLevel"
                                                                ItemsSource="{Binding DropDistributions}"
                                                                SelectedItem="{Binding SelectedDropDistribution, Mode=TwoWay}"/>
                                                        </shuxc:SizeRestrictedContentControl>
                                                    </Grid>
                                                </Border>

                                                <cwcont:HeaderedItemsControl Margin="0,8,0,4" ItemsSource="{Binding ItemsSource}">
                                                    <cwcont:HeaderedItemsControl.Header>
                                                        <shuxcpd:DataTable ColumnSpacing="8">
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                        </shuxcpd:DataTable>
                                                    </cwcont:HeaderedItemsControl.Header>
                                                    <cwcont:HeaderedItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="shvcu:ResinStatisticsItem">
                                                            <shuxcpd:DataRow Margin="16,0,16,8">
                                                                <TextBlock VerticalAlignment="Center" Text="{Binding Title, Mode=OneWay}"/>

                                                                <StackPanel
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2">
                                                                    <BitmapIcon
                                                                        Width="20"
                                                                        ShowAsMonochrome="False"
                                                                        UriSource="ms-appx:///Resource/Icon/UI_ItemIcon_106.png"/>
                                                                    <TextBlock Text="{Binding TotalResin, Mode=OneWay}"/>
                                                                </StackPanel>

                                                                <StackPanel
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2">
                                                                    <BitmapIcon
                                                                        Width="20"
                                                                        ShowAsMonochrome="False"
                                                                        UriSource="ms-appx:///Resource/Icon/UI_ItemIcon_210.png"
                                                                        Visibility="{Binding FragileResin, Converter={StaticResource EmptyObjectToBoolConverter}}"/>
                                                                    <TextBlock Text="{Binding FragileResin, Mode=OneWay}"/>
                                                                </StackPanel>

                                                                <TextBlock VerticalAlignment="Center" Text="{Binding Days, Mode=OneWay}"/>
                                                            </shuxcpd:DataRow>
                                                        </DataTemplate>
                                                    </cwcont:HeaderedItemsControl.ItemTemplate>
                                                </cwcont:HeaderedItemsControl>
                                            </StackPanel>
                                        </Flyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                            </CommandBar>
                        </Pivot.RightHeader>
                        <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationCultivateEntry}" Tag="Entry">
                            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                                    <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsRepeater
                                            x:Name="EntryRepeater"
                                            ItemTemplate="{StaticResource CultivateEntryTemplate}"
                                            ItemsSource="{Binding CultivateEntries}">
                                            <mxi:Interaction.Behaviors>
                                                <shuxb:InvalidateMeasureOnCollectionResetBehavior ItemsSource="{Binding CultivateEntries}"/>
                                            </mxi:Interaction.Behaviors>
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout
                                                    ItemsStretch="Fill"
                                                    MinColumnSpacing="12"
                                                    MinItemHeight="380"
                                                    MinItemWidth="300"
                                                    MinRowSpacing="12"/>
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </PivotItem>
                        <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationMaterialStatistics}" Tag="Statistics">
                            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                                    <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled">
                                        <!--  统计项动辄五六百条。这里必须用内置的 UniformGridLayout：
                                              它只实现视口内的条目。而 UniformStaggeredLayout（下方条目列表用的那个）
                                              的 MeasureOverride 会 for (i < ItemCount) GetOrCreateElementAt(i)，
                                              为了算列高把**全部**条目一次性实现——516 条就是 516 张卡片，
                                              虚拟化形同虚设，这正是本页比背包页卡的原因。
                                              统计卡片高度一致，用均匀网格不会有留白问题。  -->
                                        <ItemsRepeater
                                            x:Name="StatisticsRepeater"
                                            ItemTemplate="{StaticResource StatisticsItemTemplate}"
                                            ItemsSource="{Binding StatisticsItems}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout
                                                    ItemsStretch="Fill"
                                                    MinColumnSpacing="12"
                                                    MinItemWidth="240"
                                                    MinRowSpacing="12"/>
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </PivotItem>
                    </Pivot>
                </shuxc:StandardView>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationInventoryItem}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplate="{StaticResource InventoryItemTemplate}"
                            ItemsSource="{Binding InventoryItems}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>

                    </Border>
                </Border>
            </PivotItem>
        </Pivot>
    </shuxc:StandardView>
</shuxc:ScopedPage>