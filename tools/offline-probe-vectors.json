        {
          "at": "2026-11-08T10:02:00+00:00",
          "uiSource": "enemy-web-753",
          "persistedUiSource": "enemy-web-753",
          "startupUiSource": "legacy-722-bundled",
          "isGrayscale": false,
          "offlineBundled": true,
          "itemCount": 753
        }
      ],
      "expected": {
        "offlineBundled753Success": true,
        "legacyCoexistOk": true,
        "rollbackOk": false,
        "switchRestartKept": false
      }
    },
    {
      "id": "grayscale-not-user-choice",
      "why": "灰度放量给的 753：startup 与 persisted 都是 web 但 isGrayscale=true 不算用户选择；且 startup 由灰度给时也不能算重启保持",
