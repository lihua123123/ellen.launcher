<UserControl
    x:Class="Ellen.Launcher.UI.Xaml.Control.AnnouncementTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxba="using:Ellen.Launcher.UI.Xaml.Behavior.Action"
    xmlns:shuxci="using:Ellen.Launcher.UI.Xaml.Control.Image"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shuxvww="using:Ellen.Launcher.UI.Xaml.View.Window.WebView2"
    xmlns:shwhhca="using:Ellen.Launcher.Web.Hoyolab.Hk4e.Common.Announcement"
    d:DesignHeight="260"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            时间轴上的一条公告：封面 + 标题 + 剩余时间。
            条底色由封面取色决定（code-behind 在取色完成后写入），
            封面右侧叠一层「透明 → 条色」的渐变，让图和底色接得上。
            封面和标题放在同一个 StickyGroup 里、整体靠左：
            横向滚动时 code-behind 只平移这个组，于是「图 + 文字」始终贴住视口最左侧，
            而剩余时间固定在条的右端不动。
        -->
        <DataTemplate x:Key="AnnouncementTimelineBarTemplate" x:DataType="shwhhca:Announcement">
            <ItemContainer
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
                SizeChanged="OnBarSizeChanged"
                ToolTipService.ToolTip="{Binding TimeFormatted}">
                <Border
                    x:Name="Bar"
                    cw:UIElementExtensions.ClipToBounds="True"
                    Background="#3A3D44"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid>
                        <!--
                            贴左组铺满整条（自己裁剪），剩余时间叠加在右端：
                            两者不再是同一个 Grid 里互相抢宽度的两列，窄条上时间也不会被挤到换行。
                        -->
                        <Grid x:Name="StickyHost" cw:UIElementExtensions.ClipToBounds="True">
                            <Grid x:Name="StickyGroup" HorizontalAlignment="Left">
                                <Grid.RenderTransform>
                                    <TranslateTransform/>
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid
                                    x:Name="CoverHost"
                                    Grid.Column="0"
                                    Width="128">
                                    <shuxci:CachedImage
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Source="{Binding Banner}"
                                        Stretch="UniformToFill"/>
                                    <Border x:Name="CoverFade" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Offset="0" Color="#00FFFFFF"/>
                                                <GradientStop Offset="0.4" Color="#00FFFFFF"/>
                                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <!--
                                    标题压到封面上一点点（负左边距），正好落在渐变带上；
                                    它的 MaxWidth 由 code-behind 按「条宽 - 封面 - 右侧时间」算出来，保证长标题能正常省略号截断。
                                -->
                                <TextBlock
                                    x:Name="TitleText"
                                    Grid.Column="1"
                                    Margin="-24,0,10,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Subtitle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"/>
                            </Grid>
                        </Grid>

                        <TextBlock
                            x:Name="TimeText"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Opacity="0.85"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding TimeDescription}"
                            TextWrapping="NoWrap"
                            Visibility="{Binding ShouldShowTimeDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <mxi:Interaction.Behaviors>
                    <mxi:EventTriggerBehavior EventName="Tapped">
                        <shuxba:ShowWebView2WindowAction>
                            <shuxba:ShowWebView2WindowAction.ContentProvider>
                                <shuxvww:AnnouncementWebView2ContentProvider Announcement="{Binding}"/>
                            </shuxba:ShowWebView2WindowAction.ContentProvider>
                        </shuxba:ShowWebView2WindowAction>
                    </mxi:EventTriggerBehavior>
                </mxi:Interaction.Behaviors>
            </ItemContainer>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  今天 / 日期范围 / 刻度放缩  -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TodayText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"/>

            <TextBlock
                x:Name="RangeText"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Opacity="0.7"
                Style="{ThemeResource CaptionTextBlockStyle}"/>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Padding="10,2"
                    Click="OnZoomOutClick"
                    Content="－"
                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageHomeTimelineZoomOut}"/>
                <Button
                    Padding="10,2"
                    Click="OnZoomInClick"
                    Content="＋"
                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageHomeTimelineZoomIn}"/>
            </StackPanel>
        </Grid>

        <!--
            这里刻意不使用 ScrollViewer：内层滚动容器会把滚轮吃掉，
            导致页面往下滚之后回不去。横向位移由 code-behind 的 TranslateTransform 控制，
            普通滚轮完全交给页面纵向滚动，Shift + 滚轮才横向移动时间轴。
        -->
        <Grid
            x:Name="Viewport"
            Grid.Row="1"
            cw:UIElementExtensions.ClipToBounds="True"
            SizeChanged="OnViewportSizeChanged">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="HorizontalOffsetTransform"/>
                </StackPanel.RenderTransform>

                <Canvas x:Name="ScaleLayer" Height="38"/>
                <Grid>
                    <Canvas x:Name="TodayLayer" IsHitTestVisible="False">
                        <Border
                            x:Name="TodayLine"
                            Width="2"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1"/>
                    </Canvas>
                    <Canvas x:Name="BarLayer"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
