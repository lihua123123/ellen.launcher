<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            分组里的行共用同一块面板：把 SettingsCard 的底色刷成透明，
            只保留指针悬停反馈，避免每行各是一张独立卡片。
        -->
        <SolidColorBrush x:Key="SettingsCardBackground" Color="Transparent" />
        <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
    </Page.Resources>

    <ScrollViewer
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1000"
            Margin="24,20,24,32">

            <!--  品牌 / 版本  -->
            <Border Padding="20" Style="{StaticResource BorderCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="76"
                        Height="76"
                        VerticalAlignment="Center">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="18" Opacity="0.16" />
                        <Image Stretch="Uniform" Source="ms-appx:///Resource/EllenIconSourceTransparentBackgroundGradient1.png" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Ellen Launcher" />
                        <TextBlock
                            x:Name="VersionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="版本 —" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Copyright © 2022 - 2025 DGP Studio. All Rights Reserved." />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Licensed under the MIT License." />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  游戏安装目录  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="游戏" />

            <Border Style="{StaticResource SettingsGroupBorderStyle}">
                <StackPanel>
                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="原神">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7FC;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <TextBlock
                                x:Name="GenshinPathText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="未设置"
                                TextTrimming="CharacterEllipsis" />
                        </cwc:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                MinWidth="96"
                                Click="OnPickGenshinPath"
                                Content="选择文件夹"
                                Style="{StaticResource SettingButtonStyle}" />
                            <Button
                                MinWidth="72"
                                Click="OnOpenGenshinFolder"
                                Content="打开"
                                Style="{StaticResource SettingButtonStyle}" />
                        </StackPanel>
                    </cwc:SettingsCard>

                    <Border Style="{StaticResource SettingsGroupDividerStyle}" />

                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="绝区零">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7FC;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <TextBlock
                                x:Name="ZzzPathText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="未设置"
                                TextTrimming="CharacterEllipsis" />
                        </cwc:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                MinWidth="96"
                                Click="OnPickZzzPath"
                                Content="选择文件夹"
                                Style="{StaticResource SettingButtonStyle}" />
                            <Button
                                MinWidth="72"
                                Click="OnOpenZzzFolder"
                                Content="打开"
                                Style="{StaticResource SettingButtonStyle}" />
                        </StackPanel>
                    </cwc:SettingsCard>
                </StackPanel>
            </Border>

            <!--  图鉴图片资源  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="图鉴图片资源" />

            <Border Style="{StaticResource SettingsGroupBorderStyle}">
                <StackPanel>
                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="图片资源档位">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEB9F;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <TextBlock
                                x:Name="ImageQualityHint"
                                MaxWidth="520"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </cwc:SettingsCard.Description>
                        <ComboBox
                            x:Name="ImageQualityBox"
                            MinWidth="220"
                            SelectionChanged="OnImageQualityChanged"
                            Style="{StaticResource SettingsContentComboBoxStyle}">
                            <ComboBoxItem Content="精简 · 随包 webp（默认）" />
                            <ComboBoxItem Content="原图 · 一图流 PNG" />
                        </ComboBox>
                    </cwc:SettingsCard>

                    <Border Style="{StaticResource SettingsGroupDividerStyle}" />

                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="随包资源">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF012;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <TextBlock
                                x:Name="BundledText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="统计中…"
                                TextWrapping="Wrap" />
                        </cwc:SettingsCard.Description>
                    </cwc:SettingsCard>
                </StackPanel>
            </Border>

            <!--  存储空间  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="存储空间" />

            <Border Style="{StaticResource SettingsGroupBorderStyle}">
                <StackPanel>
                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="数据 文件夹">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <StackPanel>
                                <TextBlock
                                    x:Name="DataSizeText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="已使用磁盘空间：计算中…" />
                                <TextBlock
                                    x:Name="DataPathText"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </cwc:SettingsCard.Description>
                        <Button
                            MinWidth="96"
                            Click="OnOpenDataDirectory"
                            Content="打开文件夹"
                            Style="{StaticResource SettingButtonStyle}" />
                    </cwc:SettingsCard>

                    <Border Style="{StaticResource SettingsGroupDividerStyle}" />

                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Click="OnMigrateDataDirectory"
                        Header="更改数据目录"
                        IsClickEnabled="True">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8DA;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="更改目录后将会自动复制文件夹并自动重启，重启后自动删除之前的文件夹"
                                TextWrapping="Wrap" />
                        </cwc:SettingsCard.Description>
                    </cwc:SettingsCard>

                    <Border Style="{StaticResource SettingsGroupDividerStyle}" />

                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="缓存 文件夹">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74E;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <StackPanel>
                                <TextBlock
                                    x:Name="CacheSizeText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="已使用磁盘空间：计算中…" />
                                <TextBlock
                                    x:Name="CachePathText"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </cwc:SettingsCard.Description>
                        <Button
                            MinWidth="96"
                            Click="OnOpenCacheDirectory"
                            Content="打开文件夹"
                            Style="{StaticResource SettingButtonStyle}" />
                    </cwc:SettingsCard>

                    <Border Style="{StaticResource SettingsGroupDividerStyle}" />

                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="安装 文件夹">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEDA2;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <StackPanel>
                                <TextBlock
                                    x:Name="InstallSizeText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="已使用磁盘空间：计算中…" />
                                <TextBlock
                                    x:Name="InstallPathText"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </cwc:SettingsCard.Description>
                        <Button
                            MinWidth="96"
                            Click="OnOpenInstallDirectory"
                            Content="打开文件夹"
                            Style="{StaticResource SettingButtonStyle}" />
                    </cwc:SettingsCard>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</shuxc:ScopedPage>
