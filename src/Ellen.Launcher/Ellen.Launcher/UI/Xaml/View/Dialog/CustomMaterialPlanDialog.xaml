<ContentDialog
    x:Class="Ellen.Launcher.UI.Xaml.View.Dialog.CustomMaterialPlanDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
        <x:Double x:Key="CustomMaterialNumberBoxWidth">150</x:Double>

        <!-- 单个材料：图标 + 名称 -->
        <DataTemplate x:Key="SingleMaterialTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <shuxc:ItemIcon
                    Width="22"
                    Height="22"
                    Icon="{Binding Icon, Converter={StaticResource ItemIconConverter}}"
                    Quality="{Binding Quality}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <!-- 系列：横向排列每个品质的图标 + 名称，例如 嵌合种 / 并生嵌合胞 / 源生嵌合体 -->
        <DataTemplate x:Key="SeriesTemplate">
            <ItemsControl ItemsSource="{Binding Materials}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <shuxc:ItemIcon
                                Width="20"
                                Height="20"
                                Icon="{Binding Icon, Converter={StaticResource ItemIconConverter}}"
                                Quality="{Binding Quality}"/>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="CustomMaterialHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="CustomMaterialFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <Pivot Height="500" SelectedIndex="{x:Bind SelectedCategoryIndex, Mode=TwoWay}">
        <PivotItem Header="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanAvatarTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,12,0" Spacing="10">
                    <Border Padding="12" Style="{StaticResource BorderCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource CustomMaterialHeaderStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanAvatarLevelHeader}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanAvatarLevelLabel}"/>
                                <NumberBox
                                    Grid.Column="1"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="100"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind AvatarLevelCurrent, Mode=TwoWay}"/>
                                <FontIcon
                                    Grid.Column="2"
                                    Margin="4,0"
                                    FontSize="12"
                                    Glyph="&#xEBE7;"/>
                                <NumberBox
                                    Grid.Column="3"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="100"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind AvatarLevelTarget, Mode=TwoWay}"/>
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource CustomMaterialHeaderStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanTalentLevelHeader}"/>
                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ModelMetadataAvatarPlayerSkillNormalAttack}"/>
                                <NumberBox
                                    Grid.Column="1"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="10"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind SkillALevelCurrent, Mode=TwoWay}"/>
                                <FontIcon
                                    Grid.Column="2"
                                    Margin="4,0"
                                    FontSize="12"
                                    Glyph="&#xEBE7;"/>
                                <NumberBox
                                    Grid.Column="3"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="10"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind SkillALevelTarget, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ModelMetadataAvatarPlayerSkillElementalSkill}"/>
                                <NumberBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="10"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind SkillELevelCurrent, Mode=TwoWay}"/>
                                <FontIcon
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="4,0"
                                    FontSize="12"
                                    Glyph="&#xEBE7;"/>
                                <NumberBox
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="10"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind SkillELevelTarget, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ModelMetadataAvatarPlayerSkillElementalBurst}"/>
                                <NumberBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="10"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind SkillQLevelCurrent, Mode=TwoWay}"/>
                                <FontIcon
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="4,0"
                                    FontSize="12"
                                    Glyph="&#xEBE7;"/>
                                <NumberBox
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="10"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind SkillQLevelTarget, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="12" Style="{StaticResource BorderCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource CustomMaterialHeaderStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanAvatarMaterialsHeader}"/>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanElementLabel}"/>
                                <ComboBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ElementChoices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanElementPlaceholder}"
                                    SelectedItem="{x:Bind SelectedElement, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanBossLabel}"/>
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SingleMaterialTemplate}"
                                    ItemsSource="{x:Bind BossChoices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedBoss, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanSpecialtyLabel}"/>
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SingleMaterialTemplate}"
                                    ItemsSource="{x:Bind SpecialtyChoices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedSpecialty, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanTalentBookLabel}"/>
                                <ComboBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SeriesTemplate}"
                                    ItemsSource="{x:Bind TalentBookChoices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedTalentBook, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanMonsterLabel}"/>
                                <ComboBox
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SeriesTemplate}"
                                    ItemsSource="{x:Bind AvatarMonsterChoices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedAvatarMonster, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="5"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeeklyBossLabel}"/>
                                <ComboBox
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SingleMaterialTemplate}"
                                    ItemsSource="{x:Bind WeeklyBossChoices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedWeeklyBoss, Mode=TwoWay}"/>
                            </Grid>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanQualityHint}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem Header="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,12,0" Spacing="10">
                    <Border Padding="12" Style="{StaticResource BorderCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource CustomMaterialHeaderStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponLevelHeader}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponQualityLabel}"/>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind QualityChoices}"
                                    SelectedItem="{x:Bind SelectedQuality, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponLevelLabel}"/>
                                <NumberBox
                                    Grid.Column="1"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="90"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind WeaponLevelCurrent, Mode=TwoWay}"/>
                                <FontIcon
                                    Grid.Column="2"
                                    Margin="4,0"
                                    FontSize="12"
                                    Glyph="&#xEBE7;"/>
                                <NumberBox
                                    Grid.Column="3"
                                    Width="{StaticResource CustomMaterialNumberBoxWidth}"
                                    Maximum="90"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind WeaponLevelTarget, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="12" Style="{StaticResource BorderCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource CustomMaterialHeaderStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponMaterialsHeader}"/>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponMaterial1Label}"/>
                                <ComboBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SeriesTemplate}"
                                    ItemsSource="{x:Bind WeaponAscensionChoices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedWeaponAscension, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponMaterial2Label}"/>
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SeriesTemplate}"
                                    ItemsSource="{x:Bind WeaponMonster1Choices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedWeaponMonster1, Mode=TwoWay}"/>

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource CustomMaterialFieldLabelStyle}"
                                    Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanWeaponMaterial3Label}"/>
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SeriesTemplate}"
                                    ItemsSource="{x:Bind WeaponMonster2Choices}"
                                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanPlaceholder}"
                                    SelectedItem="{x:Bind SelectedWeaponMonster2, Mode=TwoWay}"/>
                            </Grid>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{shuxm:ResourceString Name=ViewDialogCustomMaterialPlanQualityHint}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</ContentDialog>
