<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.FormulasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shmf="using:Ellen.Launcher.Model.Formulas"
    xmlns:shuxb="using:Ellen.Launcher.UI.Xaml.Behavior"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shvm="using:Ellen.Launcher.ViewModel.Formulas"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    d:DataContext="{d:DesignInstance Type=shvm:FormulasViewModel}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <!--  块模板选择器先声明（引用块模板要引用它自身做递归），模板在 code-behind 里装配  -->
        <shvm:FormulaBlockTemplateSelector x:Key="FormulaBlockTemplateSelector"/>

        <DataTemplate x:Key="FormulaBlockParagraphTemplate" x:DataType="shmf:FormulaBlock">
            <TextBlock
                Margin="0,0,0,8"
                IsTextSelectionEnabled="True"
                shuxc:GuideRichText.Source="{x:Bind Text, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"/>
        </DataTemplate>

        <DataTemplate x:Key="FormulaBlockHeadingTemplate" x:DataType="shmf:FormulaBlock">
            <TextBlock
                Margin="0,12,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Text, Mode=OneWay}"
                TextWrapping="Wrap"/>
        </DataTemplate>

        <DataTemplate x:Key="FormulaBlockFormulaTemplate" x:DataType="shmf:FormulaBlock">
            <Border
                Margin="0,4,0,14"
                Padding="12,10"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <shuxc:FormulaImage HorizontalAlignment="Center" Block="{x:Bind}"/>
                </ScrollViewer>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FormulaBlockTableTemplate" x:DataType="shmf:FormulaBlock">
            <shuxc:MarkdownTable Margin="0,4,0,14" Block="{x:Bind}"/>
        </DataTemplate>

        <DataTemplate x:Key="FormulaBlockQuoteTemplate" x:DataType="shmf:FormulaBlock">
            <Border
                Margin="0,4,0,12"
                Padding="12,8,12,2"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="3,0,0,0"
                CornerRadius="0,6,6,0">
                <ItemsControl ItemTemplateSelector="{StaticResource FormulaBlockTemplateSelector}" ItemsSource="{x:Bind Blocks}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FormulaSectionTemplate" x:DataType="shmf:FormulaSection">
            <Border
                Margin="0,0,0,16"
                Padding="16,14,16,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneWay}"/>
                    <Border Height="1" Margin="0,0,0,10" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <ItemsControl ItemTemplateSelector="{StaticResource FormulaBlockTemplateSelector}" ItemsSource="{x:Bind Blocks}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FormulaTocItemTemplate" x:DataType="shmf:FormulaSection">
            <HyperlinkButton
                Padding="8,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnTocItemClick">
                <TextBlock
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"/>
            </HyperlinkButton>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding Title}"/>
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewPageFormulasSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewPageFormulasEmptyHint}"
                Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>

            <ScrollViewer
                x:Name="SectionScroller"
                Grid.Column="0"
                Padding="0,0,4,0"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="OnSectionScrollerViewChanged"
                Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ItemsControl x:Name="SectionItems" ItemTemplate="{StaticResource FormulaSectionTemplate}" ItemsSource="{Binding Sections}"/>
            </ScrollViewer>

            <Border
                Grid.Column="1"
                Width="188"
                Padding="8"
                VerticalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="8,4,8,6"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageFormulasTocHeader}"/>
                        <ItemsControl x:Name="TocItems" ItemTemplate="{StaticResource FormulaTocItemTemplate}" ItemsSource="{Binding Sections}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</shuxc:ScopedPage>
