<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.GachaLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwcont="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Ellen.Launcher.UI.Xaml.Behavior"
    xmlns:shuxba="using:Ellen.Launcher.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxcc="using:Ellen.Launcher.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Ellen.Launcher.UI.Xaml.Control.Image"
    xmlns:shuxcp="using:Ellen.Launcher.UI.Xaml.Control.Panel"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shuxvs="using:Ellen.Launcher.UI.Xaml.View.Specialized"
    xmlns:shvg="using:Ellen.Launcher.ViewModel.GachaLog"
    x:Name="RootPage"
    d:DataContext="{d:DesignInstance shvg:GachaLogViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <cwconv:BoolNegationConverter x:Key="BoolNegationConverter"/>
        <cwconv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <cwconv:BoolToObjectConverter
            x:Key="BoolNegationToVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed"/>
        <cwconv:DoubleToObjectConverter
            x:Key="DoubleToOpacityConverter"
            FalseValue="0.4"
            GreaterThan="0"
            TrueValue="1.0"/>


        <DataTemplate x:Key="HistoryWishItemTemplate" x:DataType="shvg:StatisticsItem">
            <shuxcc:VerticalCard>
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Icon="{Binding Icon}"
                        Quality="{Binding Quality}"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding Count}"
                        TextTrimming="None"
                        TextWrapping="NoWrap"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>

        <DataTemplate x:Key="HistoryWishListTemplate" x:DataType="shvg:HistoryWish">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding Version}"/>
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding Name}"/>
                </StackPanel>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{Binding FormattedTotalCount}"/>
                <ItemsControl
                    Grid.Row="1"
                    MaxWidth="134"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    ItemTemplate="{StaticResource HistoryWishItemTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{Binding OrangeUpList}"/>
                <ItemsControl
                    Grid.Row="1"
                    MaxWidth="272"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right"
                    ItemTemplate="{StaticResource HistoryWishItemTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{Binding PurpleUpList}"/>
                <TextBlock
                    Grid.Row="2"
                    Margin="0,6,0,8"
                    Opacity="0.6"
                    Text="{Binding FormattedTimeSpan}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryWishGridTemplate" x:DataType="shvg:StatisticsItem">
            <Grid>
                <shuxc:ItemIcon
                    Badge="{Binding Badge}"
                    Icon="{Binding Icon}"
                    Opacity="{Binding Count, Converter={StaticResource DoubleToOpacityConverter}}"
                    Quality="{Binding Quality}"/>
                <Border
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#80000000"
                    CornerRadius="{ThemeResource ControlCornerRadiusTopRightAndBottomLeft}">
                    <TextBlock
                        Margin="6,0,6,2"
                        Foreground="#FFFFFFFF"
                        Text="{Binding Count}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            历史列表专用：每次获取单独一条、按抽到顺序排列，
            右上角显示的是「本期第几抽」而不是持有数量。
        -->
        <DataTemplate x:Key="HistoryWishPullGridTemplate" x:DataType="shvg:StatisticsItem">
            <Grid>
                <shuxc:ItemIcon
                    Badge="{Binding Badge}"
                    Icon="{Binding Icon}"
                    Quality="{Binding Quality}"/>
                <Border
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#80000000"
                    CornerRadius="{ThemeResource ControlCornerRadiusTopRightAndBottomLeft}">
                    <TextBlock
                        Margin="6,0,6,2"
                        Foreground="#FFFFFFFF"
                        Text="{Binding PullCount}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <shuxc:StandardView HideCondition="{Binding IsInitialized, Converter={StaticResource BoolNegationConverter}}" ShowCondition="{Binding Archives.CurrentItem, Converter={StaticResource EmptyObjectToBoolConverter}}">
        <shuxc:StandardView.EmptyContent>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border
                    MinWidth="480"
                    Padding="16"
                    Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel>
                        <!--
                            切换到尚未获取过记录的游戏时，Pivot 会被 StandardView 隐藏，
                            因此空状态卡片里必须保留游戏切换入口，否则无法切回原神。
                        -->
                        <StackPanel
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{shuxm:ResourceString Name=ViewPageGachaLogGameHeader}"/>
                            <ComboBox
                                MinWidth="140"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Games}"
                                SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                Style="{ThemeResource CommandBarComboBoxStyle}"/>
                        </StackPanel>
                        <shuxci:CachedImage Height="120" Source="{StaticResource UI_EmotionIcon71}"/>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageGachaLogHint}"/>
                        <StackPanel Margin="0,24,0,0" Spacing="{StaticResource SettingsCardSpacing}">
                            <cwcont:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageGachaLogRefreshAction}"
                                Command="{Binding RefreshBySTokenCommand}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogRefreshBySTokenDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogRefreshBySToken}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE192;}"
                                IsClickEnabled="True"/>
                            <cwcont:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageGachaLogRefreshAction}"
                                Command="{Binding RefreshByWebCacheCommand}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByWebCacheDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByWebCache}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE81E;}"
                                IsClickEnabled="True"/>
                            <cwcont:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageGachaLogInputAction}"
                                Command="{Binding RefreshByManualInputCommand}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByManualInputDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByManualInput}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE765;}"
                                IsClickEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </shuxc:StandardView.EmptyContent>
        <Pivot x:Name="Pivot" Style="{ThemeResource CardPivotStyle}">
            <mxi:Interaction.Behaviors>
                <shuxb:PivotBeyondModeBehavior IsBeyondMode="{Binding IsBeyondMode}"/>
            </mxi:Interaction.Behaviors>
            <Pivot.LeftHeader>
                <StackPanel
                    Margin="6,6,0,6"
                    Orientation="Horizontal"
                    Spacing="6">
                    <shuxc:SizeRestrictedContentControl>
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Games}"
                            SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                            Style="{ThemeResource CommandBarComboBoxStyle}"/>
                    </shuxc:SizeRestrictedContentControl>
                    <shuxc:SizeRestrictedContentControl>
                        <ComboBox
                            DisplayMemberPath="Uid"
                            ItemsSource="{Binding Archives}"
                            SelectedItem="{Binding Archives.CurrentItem, Mode=TwoWay}"
                            Style="{ThemeResource CommandBarComboBoxStyle}"/>
                    </shuxc:SizeRestrictedContentControl>
                </StackPanel>
            </Pivot.LeftHeader>
            <Pivot.RightHeader>
                <CommandBar DefaultLabelPosition="Right">
                    <CommandBar.Resources>
                        <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="ControlFillColorTransparentBrush"/>
                        <!--  ReSharper disable once Xaml.RedundantResource  -->
                        <Thickness x:Key="CommandBarBorderThicknessOpen">0</Thickness>
                    </CommandBar.Resources>
                    <AppBarButton Icon="{shuxm:FontIcon Glyph=&#xE72C;}" Label="{shuxm:ResourceString Name=ViewPageGachaLogRefresh}">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Command="{Binding RefreshBySTokenCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE192;}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogRefreshBySToken}"/>
                                <MenuFlyoutItem
                                    Command="{Binding RefreshByWebCacheCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE81E;}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByWebCache}"/>
                                <MenuFlyoutItem
                                    Command="{Binding RefreshByManualInputCommand}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE765;}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByManualInput}"/>
                                <ToggleMenuFlyoutItem
                                    Icon="{shuxm:FontIcon Glyph=&#xE1CD;}"
                                    IsChecked="{Binding IsAggressiveRefresh, Mode=TwoWay}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogAggressiveRefresh}"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton
                        Command="{Binding ImportUIGFJsonCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xE8B5;}"
                        Label="{shuxm:ResourceString Name=ViewPageGachaLogUIGFImport}"/>
                    <AppBarButton
                        Command="{Binding ExportUIGFJsonCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xEDE1;}"
                        Label="{shuxm:ResourceString Name=ViewPageGachaLogUIGFExport}"/>
                    <AppBarSeparator/>
                    <AppBarToggleButton
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Icon/UI_ItemIcon_231.png}"
                        IsChecked="{Binding IsBeyondMode, Mode=TwoWay}"
                        Label="{shuxm:ResourceString Name=ViewPageGachaLogSwitchToBeyondGachaModeHeader}"
                        Visibility="{Binding IsZZZMode, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                        <AppBarToggleButton.Resources>
                            <Style BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}" TargetType="AppBarToggleButton">
                                <Setter Property="ToolTipService.ToolTip" Value="{shuxm:ResourceString Name=ViewPageGachaLogSwitchToBeyondGachaModeDescription}"/>
                            </Style>
                        </AppBarToggleButton.Resources>
                    </AppBarToggleButton>
                    <AppBarSeparator/>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            Command="{Binding RemoveArchiveCommand}"
                            Icon="{shuxm:FontIcon Glyph=&#xE74D;}"
                            Label="{shuxm:ResourceString Name=ViewPageGachaLogRemoveArchiveAction}"/>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Pivot.RightHeader>
            <PivotItem x:Name="PivotOverview" Header="{shuxm:ResourceString Name=ViewPageGachaLogPivotOverview}">
                <Grid>
                    <ScrollViewer
                        Margin="16,0"
                        cw:ScrollViewerExtensions.HorizontalScrollBarMargin="0,0,-16,0"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled">
                        <shuxcp:HorizontalEqualPanel
                            Margin="0,16"
                            MinItemWidth="302"
                            Spacing="16">
                        <shuxvs:StatisticsCard DataContext="{Binding Statistics.AvatarWish}" Visibility="{Binding DataContext.IsAvatarWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{Binding Statistics.WeaponWish}"
                            ShowCombinedModeToggle="False"
                            Visibility="{Binding DataContext.IsWeaponWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{Binding Statistics.StandardWish}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsStandardWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{Binding Statistics.ChronicledWish}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsChronicledWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{Binding Statistics.NoviceWish}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsNoviceWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:BeyondStatisticsCard
                            DataContext="{Binding Statistics.BeyondStandardWish}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsBeyondStandardWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{Binding Statistics.BeyondEventWish}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="True"
                            Visibility="{Binding DataContext.IsBeyondEventWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </shuxcp:HorizontalEqualPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem
                x:Name="PivotStatistics"
                Header="{shuxm:ResourceString Name=ViewPageGachaLogPivotStatistics}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--  二级标签：原神 历史 / 角色 / 武器；绝区零 角色 / 音擎·邦布  -->
                    <cwcont:Segmented
                        x:Name="StatisticsSegmentedGenshin"
                        Margin="16,12,16,0"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="OnStatisticsSegmentedSelectionChanged"
                        Visibility="{Binding IsZZZMode, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                        <cwcont:SegmentedItem Content="{shuxm:ResourceString Name=ViewPageGachaLogPivotHistory}"/>
                        <cwcont:SegmentedItem Content="{shuxm:ResourceString Name=ViewPageGachaLogPivotAvatar}"/>
                        <cwcont:SegmentedItem Content="{shuxm:ResourceString Name=ViewPageGachaLogPivotWeapon}"/>
                    </cwcont:Segmented>
                    <cwcont:Segmented
                        x:Name="StatisticsSegmentedZZZ"
                        Margin="16,12,16,0"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="OnStatisticsSegmentedSelectionChanged"
                        Visibility="{Binding IsZZZMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <cwcont:SegmentedItem Content="{shuxm:ResourceString Name=ViewPageGachaLogPivotHistory}"/>
                        <cwcont:SegmentedItem Content="{shuxm:ResourceString Name=ViewPageGachaLogPivotZZZAgent}"/>
                        <cwcont:SegmentedItem Content="{shuxm:ResourceString Name=ViewPageGachaLogPivotZZZWEngine}"/>
                    </cwcont:Segmented>

                    <Grid Grid.Row="1">
                        <Grid
                            x:Name="StatisticsHistoryPane">
                            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                                    <SplitView
                                        DisplayMode="Inline"
                                        IsPaneOpen="True"
                                        OpenPaneLength="439"
                                        PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <SplitView.Pane>
                                            <ListView
                                                Padding="{ThemeResource ListViewInSplitPanePadding}"
                                                ItemTemplate="{StaticResource HistoryWishListTemplate}"
                                                ItemsSource="{Binding Statistics.HistoryWishes}"
                                                SelectedItem="{Binding Statistics.HistoryWishes.CurrentItem, Mode=TwoWay}"/>
                                        </SplitView.Pane>
                                        <SplitView.Content>
                                            <ScrollViewer>
                                                <StackPanel>
                                                    <Border
                                                        Margin="16"
                                                        HorizontalAlignment="Left"
                                                        cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                                        <Grid HorizontalAlignment="Center" Style="{StaticResource AcrylicGridCardStyle}">
                                                            <cwcont:ConstrainedBox AspectRatio="1080:533">
                                                                <Grid>
                                                                    <shuxci:CachedImage
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                        Source="{Binding Statistics.HistoryWishes.CurrentItem.BannerImage}"
                                                                        Stretch="UniformToFill"
                                                                        Visibility="{Binding Statistics.HistoryWishes.CurrentItem.HasBannerImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <shuxci:CachedImage
                                                                        Width="160"
                                                                        Height="160"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Source="{Binding Statistics.HistoryWishes.CurrentItem.BannerImage}"
                                                                        Stretch="Uniform"
                                                                        Visibility="{Binding Statistics.HistoryWishes.CurrentItem.HasBannerImage, Converter={StaticResource BoolNegationToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </cwcont:ConstrainedBox>
                                                            <Border
                                                                Grid.ColumnSpan="2"
                                                                Background="{ThemeResource DarkOnlyOverlayMaskColorBrush}"
                                                                IsHitTestVisible="False"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Margin="16,0,0,0" Spacing="8">
                                                        <TextBlock
                                                            x:Name="HistoryOrangeLabel"
                                                            Margin="0,8,0,0"
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewControlStatisticsCardOrangeText}"
                                                            Visibility="{Binding Statistics.HistoryWishes.CurrentItem.SummaryList.Length, Converter={StaticResource Int32ToVisibilityConverter}}"/>
                                                        <GridView
                                                            ItemTemplate="{StaticResource HistoryWishPullGridTemplate}"
                                                            ItemsSource="{Binding Statistics.HistoryWishes.CurrentItem.SummaryList}"
                                                            SelectionMode="None"/>

                                                        <TextBlock
                                                            x:Name="HistoryPurpleLabel"
                                                            Margin="0,8,0,0"
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewControlStatisticsCardPurpleText}"
                                                            Visibility="{Binding Statistics.HistoryWishes.CurrentItem.PurpleList.Length, Converter={StaticResource Int32ToVisibilityConverter}}"/>
                                                        <GridView
                                                            ItemTemplate="{StaticResource HistoryWishPullGridTemplate}"
                                                            ItemsSource="{Binding Statistics.HistoryWishes.CurrentItem.PurpleList}"
                                                            SelectionMode="None"/>

                                                        <TextBlock
                                                            x:Name="HistoryBlueLabel"
                                                            Margin="0,8,0,0"
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewControlStatisticsCardBlueText}"
                                                            Visibility="{Binding Statistics.HistoryWishes.CurrentItem.BlueList.Length, Converter={StaticResource Int32ToVisibilityConverter}}"/>
                                                        <GridView
                                                            ItemTemplate="{StaticResource HistoryWishPullGridTemplate}"
                                                            ItemsSource="{Binding Statistics.HistoryWishes.CurrentItem.BlueList}"
                                                            SelectionMode="None"/>
                                                    </StackPanel>

                                                </StackPanel>
                                            </ScrollViewer>
                                        </SplitView.Content>
                                    </SplitView>
                                </Border>
                            </Border>
                        </Grid>
                        <Grid
                            x:Name="StatisticsAvatarPane"
                            Visibility="Collapsed">
                            <ScrollViewer>
                                <StackPanel Margin="16,0,16,16">
                                    <Border Margin="0,16,0,0" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                        <Border Padding="16,16,12,4" Style="{ThemeResource AcrylicBorderCardStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    x:Name="AvatarOrangeLabel"
                                                    Foreground="{ThemeResource OrangeColorBrush}"
                                                    Style="{StaticResource BaseTextBlockStyle}"
                                                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardOrangeText}"/>
                                                <GridView
                                                    ItemTemplate="{StaticResource HistoryWishGridTemplate}"
                                                    ItemsSource="{Binding Statistics.OrangeAvatars}"
                                                    SelectionMode="None"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>

                                    <Border Margin="0,16,0,0" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                        <Border Padding="16,16,12,4" Style="{ThemeResource AcrylicBorderCardStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    x:Name="AvatarPurpleLabel"
                                                    Foreground="{ThemeResource PurpleColorBrush}"
                                                    Style="{StaticResource BaseTextBlockStyle}"
                                                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardPurpleText}"/>
                                                <GridView
                                                    ItemTemplate="{StaticResource HistoryWishGridTemplate}"
                                                    ItemsSource="{Binding Statistics.PurpleAvatars}"
                                                    SelectionMode="None"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <Grid
                            x:Name="StatisticsWeaponPane"
                            Visibility="Collapsed">
                            <ScrollViewer>
                                <StackPanel Margin="16,0,16,16">
                                    <Border Margin="0,16,0,0" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                        <Border Padding="16,16,12,4" Style="{ThemeResource AcrylicBorderCardStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    x:Name="WeaponOrangeLabel"
                                                    Foreground="{ThemeResource OrangeColorBrush}"
                                                    Style="{StaticResource BaseTextBlockStyle}"
                                                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardOrangeText}"/>
                                                <GridView
                                                    ItemTemplate="{StaticResource HistoryWishGridTemplate}"
                                                    ItemsSource="{Binding Statistics.OrangeWeapons}"
                                                    SelectionMode="None"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <Border Margin="0,16,0,0" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                        <Border Padding="16,16,12,4" Style="{ThemeResource AcrylicBorderCardStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    x:Name="WeaponPurpleLabel"
                                                    Foreground="{ThemeResource PurpleColorBrush}"
                                                    Style="{StaticResource BaseTextBlockStyle}"
                                                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardPurpleText}"/>
                                                <GridView
                                                    ItemTemplate="{StaticResource HistoryWishGridTemplate}"
                                                    ItemsSource="{Binding Statistics.PurpleWeapons}"
                                                    SelectionMode="None"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <Border Margin="0,16,0,0" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                        <Border Padding="16,16,12,4" Style="{ThemeResource AcrylicBorderCardStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    x:Name="WeaponBlueLabel"
                                                    Foreground="{ThemeResource BlueColorBrush}"
                                                    Style="{StaticResource BaseTextBlockStyle}"
                                                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardBlueText}"/>
                                                <GridView
                                                    ItemTemplate="{StaticResource HistoryWishGridTemplate}"
                                                    ItemsSource="{Binding Statistics.BlueWeapons}"
                                                    SelectionMode="None"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem
                x:Name="PivotCountdown"
                Header="{shuxm:ResourceString Name=ViewPageGachaLogPivotCountdown}">
                <Grid>
                    <shuxc:Loading
                        Margin="16"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        IsLoading="{Binding WishCountdownViewModel.IsInitialized, Converter={StaticResource BoolNegationConverter}}"
                        Style="{ThemeResource DefaultLoadingViewStyle}"/>
                    <ScrollViewer
                        Margin="16,0"
                        cw:ScrollViewerExtensions.HorizontalScrollBarMargin="0,0,-16,0"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <Grid>
                            <shuxcp:HorizontalEqualPanel
                                Margin="0,16"
                                MinItemWidth="320"
                                Spacing="16"
                                Visibility="{Binding IsZZZMode, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                                <shuxvs:CountdownCard Title="{shuxm:ResourceString Name=ViewPageGachaLogOrangeAvatarCountdown}" Countdowns="{Binding WishCountdownViewModel.WishCountdowns.OrangeAvatars}"/>
                                <shuxvs:CountdownCard Title="{shuxm:ResourceString Name=ViewPageGachaLogPurpleAvatarCountdown}" Countdowns="{Binding WishCountdownViewModel.WishCountdowns.PurpleAvatars}"/>
