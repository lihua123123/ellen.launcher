<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.WikiMonsterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clw="using:CommunityToolkit.Labs.WinUI"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shm="using:Ellen.Launcher.Model"
    xmlns:shma="using:Ellen.Launcher.Model.EnemyArchive"
    xmlns:shmmi="using:Ellen.Launcher.Model.Metadata.Item"
    xmlns:shmmm="using:Ellen.Launcher.Model.Metadata.Monster"
    xmlns:shuxb="using:Ellen.Launcher.UI.Xaml.Behavior"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxca="using:Ellen.Launcher.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Ellen.Launcher.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Ellen.Launcher.UI.Xaml.Control.Image"
    xmlns:shuxct="using:Ellen.Launcher.UI.Xaml.Control.TextBlock"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    xmlns:shuxvs="using:Ellen.Launcher.UI.Xaml.View.Specialized"
    xmlns:shvw="using:Ellen.Launcher.ViewModel.Wiki"
    d:DataContext="{d:DesignInstance Type=shvw:WikiMonsterViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="22"
                    Height="22"
                    Margin="0,0,8,0"
                    Source="{Binding SideIconUri, Mode=OneWay}"/>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding Value}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MonsterListTemplate" x:DataType="shma:MonsterCatalogEntry">
            <!--  MinHeight 与「48 头像 + 6*2 外边距」对齐；头像列固定 48，缺头像的条目文字才不会左移 -->
            <Grid MinHeight="60" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Margin="0,6"
                    Source="{Binding Icon, Converter={StaticResource MonsterCatalogIconConverter}, Mode=OneWay}"
                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding CategoryName}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  侧边栏一级：分类（「全部」+ 各 Category），右侧带条目数  -->
        <DataTemplate x:Key="MonsterCategoryTemplate" x:DataType="shma:MonsterCategoryGroup">
            <Grid MinHeight="36" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding CountText}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MonsterBaseValueTemplate" x:DataType="shm:NameStringValue">
            <cwc:SettingsCard
                MinHeight="40"
                Padding="0,0,16,0"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <cwc:SettingsCard.Resources>
                    <!--  ReSharper disable Xaml.RedundantResource  -->
                    <x:Double x:Key="SettingsCardLeftIndention">16</x:Double>
                    <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                    <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                    <!--  ReSharper restore Xaml.RedundantResource  -->
                </cwc:SettingsCard.Resources>
                <cwc:SettingsCard.Header>
                    <TextBlock Text="{Binding Name}" TextWrapping="NoWrap"/>
                </cwc:SettingsCard.Header>
                <TextBlock Text="{Binding Value}"/>
            </cwc:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="MonsterDropTemplate" x:DataType="shmmi:DisplayItem">
            <shuxcc:HorizontalCard>
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Icon="{Binding Icon, Converter={StaticResource ItemIconConverter}}"
                        Quality="{Binding RankLevel}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding Name}"/>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="MonsterGridTemplate" x:DataType="shma:MonsterCatalogEntry">
            <shuxcc:VerticalCard Width="82">
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon
                        Icon="{Binding Icon, Converter={StaticResource MonsterCatalogIconConverter}, Mode=OneWay}"
                        Quality="QUALITY_NONE"
                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        Margin="2,0"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>

        <!--  档案：抗性单元格（已展开好，界面不做条件判断）  -->
        <DataTemplate x:Key="MonsterArchiveResistanceTemplate" x:DataType="shma:EnemyArchiveResistanceCell">
            <Border
                Padding="10,7"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        shuxc:GuideRichText.AutoElementColor="True"
                        shuxc:GuideRichText.Source="{Binding Label}"
                        TextWrapping="NoWrap"/>
                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Foreground="#FFFF99A4"
                        Text="{Binding ValueText}"
                        Visibility="{Binding IsImmune, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Text="{Binding ValueText}"
                        Visibility="{Binding IsImmune, Converter={StaticResource BoolToVisibilityRevertConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  档案：产球行（血量左对齐 / 微粒居中 / 晶球右对齐；掉落数字按元素上色，无掉落留空）  -->
        <DataTemplate x:Key="MonsterArchiveEnergyRowTemplate" x:DataType="shma:EnemyArchiveEnergyCell">
            <Grid Padding="0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding HpText}"
                    TextAlignment="Left"/>
                <TextBlock
                    Grid.Column="1"
                    Foreground="{Binding ParticleElementKey, Converter={StaticResource ElementKeyToBrushConverter}}"
                    Text="{Binding ParticleText}"
                    TextAlignment="Center"/>
                <TextBlock
                    Grid.Column="2"
                    Foreground="{Binding OrbElementKey, Converter={StaticResource ElementKeyToBrushConverter}}"
                    Text="{Binding OrbText}"
                    TextAlignment="Right"/>
            </Grid>
        </DataTemplate>

        <!--  档案：特殊机制  -->
        <DataTemplate x:Key="MonsterArchiveMechanicTemplate" x:DataType="shma:EnemyArchiveMechanic">
            <StackPanel Margin="0,0,0,10">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock
                    shuxc:GuideRichText.AutoElementColor="True"
                    shuxc:GuideRichText.StatColor="True"
                    shuxc:GuideRichText.Source="{Binding Text}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!--  档案：技能（每条一张卡片，避免纯文本糊成一片）  -->
        <DataTemplate x:Key="MonsterArchiveSkillTemplate" x:DataType="shma:EnemyArchiveSkill">
            <Border
                Margin="0,0,0,8"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <shuxci:CachedImage
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Source="{Binding IconUri}"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding Name}"/>
                        <Border
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Tag}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        shuxc:GuideRichText.AutoElementColor="True"
                        shuxc:GuideRichText.StatColor="True"
                        shuxc:GuideRichText.Source="{Binding Description}"
                        TextWrapping="Wrap"/>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        shuxc:GuideRichText.AutoElementColor="True"
                        shuxc:GuideRichText.StatColor="True"
                        shuxc:GuideRichText.Source="{Binding Tips}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasTips, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{Binding HasCombo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveSkillCombo}"/>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ComboText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
            <!--  档案：护盾（XML 图鉴源独有字段）  -->
        <DataTemplate x:Key="MonsterArchiveShieldTemplate" x:DataType="shma:EnemyArchiveShield">
            <Border
                Margin="0,0,0,8"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Name}"/>
                    <TextBlock
                        shuxc:GuideRichText.AutoElementColor="True"
                        shuxc:GuideRichText.Bold="True"
                        shuxc:GuideRichText.StatColor="True"
                        shuxc:GuideRichText.StatElement="{Binding ElementKey}"
                        shuxc:GuideRichText.Source="{Binding Description}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
</Page.Resources>

    <!--  P2 双视图：默认 IsLegacyMode=true，下面这段 legacy 722 视图与绑定一字不改；
          切 enemy-web-753 时显示并列 Web 视图，一键回滚只需把 flag 切回 legacy。  -->
    <Grid x:Name="PageRoot">
    <shuxc:StandardView
        ShowCondition="{Binding Monsters, Converter={StaticResource EmptyObjectToBoolConverter}}"
        Visibility="{Binding IsLegacyMode, Converter={StaticResource BoolToVisibilityConverter}}">
        <shuxc:StandardView.EmptyContent>
            <shuxc:Loading IsLoading="{Binding Monsters, Converter={StaticResource EmptyObjectToBoolRevertConverter}}" Style="{ThemeResource DefaultLoadingViewStyle}"/>
        </shuxc:StandardView.EmptyContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--  P5：首次无缓存且不可达 → 显式回退内置 722，横幅说明原因（不是白屏）  -->
            <InfoBar
                Grid.Row="0"
                Margin="16,8,16,0"
                IsClosable="False"
                IsOpen="{Binding IsFallbackBannerVisible}"
                Message="{Binding FallbackBannerText}"
                Severity="Warning"
                Title="ellen.wiki 数据不可用"/>

            <Border Grid.Row="1" Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Style="{ThemeResource AcrylicSecondaryBorderCardStyle}">
                    <CommandBar
                        BorderBrush="{x:Null}"
                        BorderThickness="0"
                        DefaultLabelPosition="Right">
                        <CommandBar.Content>
                            <shuxc:LayoutSwitch
                                x:Name="ItemsPanelSelector"
                                Margin="6,8,0,0"
                                LocalSettingKeySuffixForCurrent="WikiMonsterPage.Monsters"/>
                        </CommandBar.Content>
                        <AppBarElementContainer>
                            <shuxca:AutoSuggestTokenBox
                                Width="600"
                                Height="44"
                                Margin="6,-2,6,6"
                                HorizontalAlignment="Right"
                                VerticalContentAlignment="Center"
                                AvailableTokens="{Binding SearchData.AvailableTokens}"
                                FilterCommand="{Binding FilterCommand}"
                                ItemsSource="{Binding SearchData.FilterTokens, Mode=TwoWay}"
                                MaximumTokens="5"
                                PlaceholderText="{shuxm:ResourceString Name=ViewPageWiKiMonsterAutoSuggestBoxPlaceHolder}"
                                QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                                SuggestedItemTemplate="{StaticResource TokenTemplate}"
                                SuggestedItemsSource="{Binding SearchData.AvailableTokens.Values}"
                                Text="{Binding SearchData.FilterToken, Mode=TwoWay}"
                                TokenItemTemplate="{StaticResource TokenTemplate}"/>
                        </AppBarElementContainer>
                        <!--  P5b：切换到 ellen.wiki 753 视图。这是生产代码里唯一写持久化的入口，
                              没有它 persistedUiSource 永远为空，G7a 的「切换重启保持」判不出来。  -->
                        <AppBarButton
                            Command="{Binding SwitchToWebCommand}"
                            Icon="{shuxm:FontIcon Glyph=&#xE8AB;}"
                            Label="切换到 753"/>
                    </CommandBar>
                </Border>
            </Border>

            <cwc:SwitchPresenter
                Grid.Row="2"
                ContentTransitions="{ThemeResource EntranceThemeTransitions}"
                Value="{Binding ElementName=ItemsPanelSelector, Path=Current}">
                <cwc:Case Value="List">
                    <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <SplitView
                                DisplayMode="Inline"
                                IsPaneOpen="True"
                                OpenPaneLength="{StaticResource CompatSplitViewOpenPaneLength4}"
                                PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <SplitView.Pane>
                                    <!--  两级侧边栏：左「分类」/ 右「该分类下的敌人」  -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <ListView
                                            Grid.Column="0"
                                            Padding="4,12,4,12"
                                            ItemTemplate="{StaticResource MonsterCategoryTemplate}"
                                            ItemsSource="{Binding Categories}"
                                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                            SelectionMode="Single"/>
                                        <ListView
                                            Grid.Column="1"
                                            Padding="{ThemeResource ListViewInSplitPanePadding}"
                                            ItemTemplate="{StaticResource MonsterListTemplate}"
                                            ItemsSource="{Binding Monsters}"
                                            SelectedItem="{Binding Monsters.CurrentItem, Mode=TwoWay}"
                                            SelectionMode="Single">
                                            <mxi:Interaction.Behaviors>
                                                <shuxb:SelectedItemInViewBehavior/>
                                            </mxi:Interaction.Behaviors>
                                        </ListView>
                                    </Grid>
                                </SplitView.Pane>
                                <SplitView.Content>
                                    <ScrollViewer shuxc:ScrollViewerHelper.ScrollToTopAssociatedObject="{Binding Monsters.CurrentItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition MaxWidth="800"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Padding="16" Spacing="16">
                                                <StackPanel.ChildrenTransitions>
                                                    <EntranceThemeTransition FromVerticalOffset="50"/>
                                                    <RepositionThemeTransition IsStaggeringEnabled="False"/>
                                                </StackPanel.ChildrenTransitions>
                                                <!--  长标题（如「历经百战的暝视龙·霜雪苛念」）要能换行：放 * 列并开 Wrap，行高才不会被压重叠  -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Margin="1,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                                        TextWrapping="Wrap"
                                                        Text="{Binding Monsters.CurrentItem.Title}"/>
                                                    <!--  补全过档案的敌人：标注数据来源（图鉴卡制图 @Csxylic）  -->
                                                    <HyperlinkButton
                                                        Grid.Column="1"
                                                        Padding="2,0"
                                                        VerticalAlignment="Center"
                                                        Content="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveSource}"
                                                        NavigateUri="https://www.miyoushe.com/ys/accountCenter/collectionList?id=258229537"
                                                        Visibility="{Binding Monsters.CurrentItem.Archive, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                                                </Grid>
                                                <shuxct:DescriptionTextBlock
                                                    Margin="1,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Description="{Binding Monsters.CurrentItem.Description}"
                                                    Opacity="0.7"
                                                    TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                                                <clw:TokenView ItemsSource="{Binding Monsters.CurrentItem.Affixes}" SelectionMode="None"/>
                                                <shuxvs:BaseValueSlider
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    BaseValueInfo="{Binding BaseValueInfo, Mode=OneWay}"
                                                    IsPromoteVisible="False"/>
                                                <ItemsControl
                                                    ItemTemplate="{StaticResource MonsterBaseValueTemplate}"
                                                    ItemsPanel="{StaticResource UniformGridColumns2Spacing4Template}"
                                                    ItemsSource="{Binding Monsters.CurrentItem.BaseValue.SubHurts}"
                                                    Visibility="{Binding Monsters.CurrentItem.ShowFallbackResistances, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.Resources>
                                                        <!--  ReSharper disable Xaml.RedundantResource  -->
                                                        <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                                        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                                        <!--  ReSharper restore Xaml.RedundantResource  -->
                                                    </ItemsControl.Resources>
                                                </ItemsControl>
                                                <!--  档案：抗性（含机制状态）/ 机制 / 产球 / 技能  -->
                                                <Border
                                                    Padding="16"
                                                    Style="{ThemeResource BorderShimmerStyle}"
                                                    Visibility="{Binding Monsters.CurrentItem.HasArchiveResistances, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Spacing="12">
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource BaseTextBlockStyle}"
                                                                Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveResistances}"/>
                                                            <!--
                                                                读值证据等级胶囊。
                                                                ⚠️ 语义：它描述的是**当前选中那一行**（常态行 / 当前状态行）的 evidence，
                                                                随 SelectedResistanceStateIndex 切换而变 —— 不是整个条目的汇总。
                                                                未评级（null）时不显示；「无胶囊」只表示这行未走 VLM 通道，不代表可疑。
                                                                文案与配色在 VM 的 EvidenceStyles 里，落点选「抗性数据」标题行是因为它独占一行、
                                                                不与下面的 Segmented 争宽（实测只占 124/768）。
                                                            -->
                                                            <Border
                                                                Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding ResistanceEvidenceBackground}"
                                                                CornerRadius="4"
                                                                Visibility="{Binding ResistanceEvidenceText, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{Binding ResistanceEvidenceForeground}"
                                                                    Text="{Binding ResistanceEvidenceText}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <!--
                                                            多状态敌人变多后，把 ComboBox 换成 Segmented 胶囊 Tab。
                                                            ⚠️ 绑的是 Segmented 自己声明的 SelectedIndex（VM 已有的 int）。
                                                            用 {Binding} 绑不存在的属性**不会崩、只会静默失效**，
                                                            所以改完必须实际切换一次状态，确认抗性数值跟着变。
                                                        -->
                                                        <cwc:Segmented
                                                            HorizontalAlignment="Left"
                                                            ItemsSource="{Binding ResistanceStates}"
                                                            SelectedIndex="{Binding SelectedResistanceStateIndex, Mode=TwoWay}"
                                                            Visibility="{Binding Monsters.CurrentItem.Archive.Resistances.HasStates, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <cwc:Segmented.ItemTemplate>
                                                                <DataTemplate x:DataType="shma:EnemyArchiveResistanceState">
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </cwc:Segmented.ItemTemplate>
                                                        </cwc:Segmented>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource MonsterArchiveResistanceTemplate}"
                                                            ItemsPanel="{StaticResource UniformGridColumns2Spacing4Template}"
                                                            ItemsSource="{Binding ResistanceCells, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Padding="16"
                                                    Style="{ThemeResource BorderShimmerStyle}"
                                                    Visibility="{Binding Monsters.CurrentItem.HasArchiveMechanics, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveMechanics}"/>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource MonsterArchiveMechanicTemplate}"
                                                            ItemsSource="{Binding Monsters.CurrentItem.Archive.Mechanics}"/>
                                                    </StackPanel>
                                                </Border>

                                                                                                <!--  档案：护盾（XML 图鉴源独有字段）  -->
                                                <Border
                                                    Padding="16"
                                                    Style="{ThemeResource BorderShimmerStyle}"
                                                    Visibility="{Binding Monsters.CurrentItem.HasArchiveShield, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveShield}"/>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource MonsterArchiveShieldTemplate}"
                                                            ItemsSource="{Binding Monsters.CurrentItem.Archive.Shield}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Padding="16"
                                                    Style="{ThemeResource BorderShimmerStyle}"
                                                    Visibility="{Binding Monsters.CurrentItem.HasArchiveEnergy, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveEnergy}"/>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Opacity="0.7"
                                                                Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveEnergyHp}"
                                                                TextAlignment="Left"/>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Opacity="0.7"
                                                                Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveEnergyParticle}"
                                                                TextAlignment="Center"/>
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Opacity="0.7"
                                                                Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveEnergyOrb}"
                                                                TextAlignment="Right"/>
                                                        </Grid>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource MonsterArchiveEnergyRowTemplate}"
                                                            ItemsSource="{Binding Monsters.CurrentItem.Archive.Energy.Cells}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Padding="16"
                                                    Style="{ThemeResource BorderShimmerStyle}"
                                                    Visibility="{Binding Monsters.CurrentItem.HasArchiveSkills, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewPageWikiMonsterArchiveSkills}"/>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource MonsterArchiveSkillTemplate}"
                                                            ItemsSource="{Binding Monsters.CurrentItem.Archive.Skills}"/>
                                                    </StackPanel>
                                                </Border>
                                                <!--  上游 GIEnemyChartXML 没有掉落物数据，掉落区整块不渲染（DropsView 恒为空）  -->
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </SplitView.Content>
                            </SplitView>
                        </Border>
                    </Border>
                </cwc:Case>
                <cwc:Case Value="Grid">
                    <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <GridView
                                Padding="16,16,4,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                ItemContainerStyle="{StaticResource LargeGridViewItemStyle}"
                                ItemTemplate="{StaticResource MonsterGridTemplate}"
                                ItemsSource="{Binding Monsters}"
                                SelectedItem="{Binding Monsters.CurrentItem, Mode=TwoWay}"
                                SelectionMode="Single">
                                <mxi:Interaction.Behaviors>
                                    <shuxb:SelectedItemInViewBehavior/>
                                </mxi:Interaction.Behaviors>
                            </GridView>
                        </Border>
                    </Border>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </Grid>
    </shuxc:StandardView>

        <!--  ============ P2 Web 视图：ellen.wiki 753 条（默认折叠）============  -->
        <Grid
            Padding="16"
            Visibility="{Binding IsWebMode, Converter={StaticResource BoolToVisibilityConverter}}"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--  分类 / 搜索  -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ComboBox
                    Grid.Column="0"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding WebCategories}"
                    SelectedItem="{Binding WebSelectedCategory, Mode=TwoWay}"/>
                <shuxca:AutoSuggestTokenBox
                    Grid.Column="1"
                    Height="44"
                    VerticalContentAlignment="Center"
                    AvailableTokens="{Binding WebSearchData.AvailableTokens}"
                    FilterCommand="{Binding WebFilterCommand}"
                    ItemsSource="{Binding WebSearchData.FilterTokens, Mode=TwoWay}"
                    MaximumTokens="5"
                    PlaceholderText="{shuxm:ResourceString Name=ViewPageWiKiMonsterAutoSuggestBoxPlaceHolder}"
                    QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                    ShowTokenCounter="False"
                    Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                    SuggestedItemTemplate="{StaticResource TokenTemplate}"
                    SuggestedItemsSource="{Binding WebSearchData.AvailableTokens.Values}"
                    Text="{Binding WebSearchData.FilterToken, Mode=TwoWay}"
                    TokenItemTemplate="{StaticResource TokenTemplate}"/>
            </Grid>

            <!--  列表 + 详情  -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <ListView
                        x:Name="WebMonsterList"
                        ItemsSource="{Binding WebMonsters}"
                        SelectedItem="{Binding WebCurrentItem, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!--  列表项只保留三样：头像 / 名称 / 分类（2026-11-09 按要求精简，别再加数值行）  -->
                                <Grid Padding="4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <shuxci:CachedImage
                                        Width="40"
                                        Height="40"
                                        VerticalAlignment="Center"
                                        Source="{Binding IconUri}"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.65"
                                            Text="{Binding CategoryLabel}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!--  P5：首次同步中/无数据的空态（显式文案，不留白屏）  -->
                    <TextBlock
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Text="{Binding WebEmptyStateText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding WebEmptyStateText, Converter={StaticResource EmptyObjectToBoolConverter}}"/>
                </Grid>

                <ScrollViewer x:Name="WebDetailScroll" Grid.Column="1">
                    <!--  详情：主栏（标题 / 等级 / 抗性 / 机制 / 能量 / 一图流）+ 右侧技能栏。
                          版式按用户要求回到旧版图鉴的「分区卡片」，技能单独放右侧，别再改回单列平铺。
                          集合类绑到 VM 直属属性；ElementName 指向页面根，避免 WinUI3 不支持的 RelativeSource AncestorType。  -->
                    <Grid Padding="12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!--  ============ 主栏 ============  -->
                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding WebCurrentItem.Name}"/>
                                <TextBlock Opacity="0.7" Text="{Binding WebCurrentItem.NameEn}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Opacity="0.7" Text="{Binding WebCurrentItem.CategoryLabel}"/>
                                    <TextBlock Opacity="0.7" Text="{Binding WebCurrentItem.Subtitle}"/>
                                </StackPanel>
                            </StackPanel>

                            <!--  等级滑块：拖动查看该等级下的基础生命值 / 攻击力（防御力已按用户要求去掉）。
                                  复用 WikiAvatarPage / WikiWeaponPage 同一个控件，敌人没有突破，所以 IsPromoteVisible=False。
                                  源里没有 baseStats 的条目 → WebBaseValueInfo 为 null → 整块隐藏，不显示 0。  -->
                            <shuxvs:BaseValueSlider
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                BaseValueInfo="{Binding WebBaseValueInfo, Mode=OneWay}"
                                IsPromoteVisible="False"
                                Visibility="{Binding WebBaseValueInfo, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>

                            <!--  抗性数据：两列网格，元素名自动上色（与旧版同一套 GuideRichText）  -->
                            <Border Padding="16" Style="{ThemeResource BorderShimmerStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="抗性数据"/>
                                    <ComboBox
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding DataContext.WebResistanceStates, ElementName=PageRoot}"
                                        SelectedIndex="{Binding DataContext.WebSelectedResistanceStateIndex, ElementName=PageRoot, Mode=TwoWay}"
                                        Visibility="{Binding DataContext.WebHasResistanceStates, ElementName=PageRoot, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <ItemsControl
                                        ItemsPanel="{StaticResource UniformGridColumns2Spacing4Template}"
                                        ItemsSource="{Binding DataContext.WebResistanceCells, ElementName=PageRoot}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="10,7"
                                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            shuxc:GuideRichText.AutoElementColor="True"
                                                            shuxc:GuideRichText.Source="{Binding Label}"
                                                            TextWrapping="NoWrap"/>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding ValueText}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!--  特殊机制：源里没有 notes 的条目整块隐藏  -->
                            <Border
                                Padding="16"
                                Style="{ThemeResource BorderShimmerStyle}"
                                Visibility="{Binding WebCurrentItem.HasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="特殊机制"/>
                                    <ItemsControl ItemsSource="{Binding WebCurrentItem.Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10" Spacing="2">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"
                                                        Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <TextBlock
                                                        Opacity="0.9"
                                                        Text="{Binding Text}"
                                                        TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!--  元素能量（产球）：坚盾值 / 元素微粒 / 元素晶球 三列，无数据的条目整块隐藏  -->
                            <Border
                                Padding="16"
                                Style="{ThemeResource BorderShimmerStyle}"
                                Visibility="{Binding WebCurrentItem.HasEnergy, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="元素能量"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Opacity="0.7"
                                            Text="坚盾值"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Opacity="0.7"
                                            Text="元素微粒"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Opacity="0.7"
                                            Text="元素晶球"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding WebCurrentItem.EnergyRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding HpText}"/>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Center"
                                                        Text="{Binding ParticleText}"/>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        Text="{Binding OrbText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!--  一图流：大图展示和角色图鉴的「名片」同一套（满宽 + 圆角裁剪，不设 MaxWidth）。
                                  离线未缓存时是随包 256px 预览，ArtNote 显式说明，不冒充原图。  -->
                            <Border
                                Padding="16"
                                Style="{ThemeResource BorderShimmerStyle}"
                                Visibility="{Binding WebCurrentItem.HasArt, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="一图流"/>
                                    <!--  一图流：大图展示和角色图鉴的「名片」同一套（满宽 + 圆角裁剪，不设 MaxWidth）。
                                          离线未缓存时是随包 256px 预览，ArtNote 显式说明，不冒充原图。
                                          FadeIn=False：切换敌人时这张图会重建，淡入看起来就是闪一下。  -->
                                    <Border
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                                        <shuxci:CachedImage
                                            HorizontalAlignment="Stretch"
                                            FadeIn="False"
                                            Source="{Binding WebCurrentItem.ArtUri}"
                                            Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{Binding WebCurrentItem.ArtNote}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding WebCurrentItem.ArtNote, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  ============ 右侧：技能 ============  -->
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            VerticalAlignment="Top"
                            Style="{ThemeResource BorderShimmerStyle}"
                            Visibility="{Binding WebCurrentItem.HasSkills, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="技能"/>
                                <ItemsControl ItemsSource="{Binding WebCurrentItem.Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12,10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <!--  技能图标：源里 skill-N.webp；上游没给图标时整个图标位不占宽。
                                                          图标本身是白色线稿（透明底），浅色主题下必须有深色底板才看得见。  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="40"
                                                        Height="40"
                                                        VerticalAlignment="Top"
                                                        Background="#59000000"
                                                        CornerRadius="8"
                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <shuxci:CachedImage
                                                            Width="32"
                                                            Height="32"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FadeIn="False"
                                                            Source="{Binding IconUri}"
                                                            Stretch="Uniform"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                                            <TextBlock
                                                                Opacity="0.7"
                                                                Text="{Binding Tag}"
                                                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        <TextBlock
                                                            Opacity="0.85"
                                                            Text="{Binding DescriptionText}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</shuxc:ScopedPage>