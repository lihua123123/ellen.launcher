<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.TeyvatMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <!--
        内嵌空荧酒馆的提瓦特互动地图（map_front_v3 的线上构建 https://v3.yuanshen.site/）。
        这类地图页面按 100vw/100vh 铺满视口设计，所以这里不套卡片、不加内边距，
        让 WebView2 直接占满内容区，观感与网页版一致。
    -->
    <Grid>
        <WebView2 x:Name="MapWebView" DefaultBackgroundColor="Transparent"/>
        <StackPanel
            x:Name="MapLoadFailedHint"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewWebView2WindowLoadFailedHint}"/>
            <HyperlinkButton
                HorizontalAlignment="Center"
                Content="{shuxm:ResourceString Name=ViewTeyvatMapHeader}"
                NavigateUri="https://v3.yuanshen.site/"/>
        </StackPanel>
    </Grid>
</shuxc:ScopedPage>
