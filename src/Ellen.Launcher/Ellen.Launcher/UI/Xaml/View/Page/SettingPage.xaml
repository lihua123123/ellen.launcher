<shuxc:ScopedPage
    x:Class="Ellen.Launcher.UI.Xaml.View.Page.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxc="using:Ellen.Launcher.UI.Xaml.Control"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            分组内所有行共用一块面板：把 SettingsCard 的底色刷成透明，
            只保留指针悬停反馈，避免每行各是一张独立卡片。
        -->
        <SolidColorBrush x:Key="SettingsCardBackground" Color="Transparent" />
        <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />

        <!--  卡片在窄窗口下把说明折到标题下面，避免文字被挤成一条线  -->
        <x:Double x:Key="SettingsCardWrapThreshold">520</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">460</x:Double>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Margin" Value="12,12,12,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Regular">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Margin" Value="24,20,24,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ContentRoot"
                HorizontalAlignment="Stretch"
                Margin="24,20,24,32">

                <TextBlock
                    Margin="1,0,0,0"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="设置" />
                <TextBlock
                    x:Name="VersionText"
                    Margin="2,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="版本 —" />

                <!--  游戏安装目录  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="游戏" />

                <Border Style="{StaticResource SettingsGroupBorderStyle}">
                    <StackPanel>
                        <cwc:SettingsCard
                            Margin="0"
                            Padding="16,16"
                            BorderThickness="0"
                            Header="原神">
                            <cwc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7FC;" />
                            </cwc:SettingsCard.HeaderIcon>
                            <cwc:SettingsCard.Description>
                                <TextBlock
                                    x:Name="GenshinPathText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="未设置"
                                    TextTrimming="CharacterEllipsis" />
                            </cwc:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    MinWidth="96"
                                    Click="OnPickGenshinPath"
                                    Content="选择文件夹"
                                    Style="{StaticResource SettingButtonStyle}" />
                                <Button
                                    MinWidth="72"
                                    Click="OnOpenGenshinFolder"
                                    Content="打开"
                                    Style="{StaticResource SettingButtonStyle}" />
                            </StackPanel>
                        </cwc:SettingsCard>

                        <Border Style="{StaticResource SettingsGroupDividerStyle}" />

                        <cwc:SettingsCard
                            Margin="0"
                            Padding="16,16"
                            BorderThickness="0"
                            Header="绝区零">
                            <cwc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7FC;" />
                            </cwc:SettingsCard.HeaderIcon>
                            <cwc:SettingsCard.Description>
                                <TextBlock
                                    x:Name="ZzzPathText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="未设置"
                                    TextTrimming="CharacterEllipsis" />
                            </cwc:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    MinWidth="96"
                                    Click="OnPickZzzPath"
                                    Content="选择文件夹"
                                    Style="{StaticResource SettingButtonStyle}" />
                                <Button
                                    MinWidth="72"
                                    Click="OnOpenZzzFolder"
                                    Content="打开"
                                    Style="{StaticResource SettingButtonStyle}" />
                            </StackPanel>
                        </cwc:SettingsCard>
                    </StackPanel>
                </Border>

                <!--  图鉴图片资源  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="图鉴图片资源" />

                <Border Style="{StaticResource SettingsGroupBorderStyle}">
                    <cwc:SettingsCard
                        Margin="0"
                        Padding="16,16"
                        BorderThickness="0"
                        Header="图片资源档位">
                        <cwc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEB9F;" />
                        </cwc:SettingsCard.HeaderIcon>
                        <cwc:SettingsCard.Description>
                            <TextBlock
                                x:Name="ImageQualityHint"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </cwc:SettingsCard.Description>
                        <ComboBox
                            x:Name="ImageQualityBox"
                            MinWidth="200"
                            SelectionChanged="OnImageQualityChanged"
                            Style="{StaticResource SettingsContentComboBoxStyle}">
                            <ComboBoxItem Content="精简 · 随包 webp" />
                            <ComboBoxItem Content="原图 · 一图流 PNG" />
                        </ComboBox>
                    </cwc:SettingsCard>
                </Border>

                <!--  软件数据与缓存目录  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="软件数据与缓存" />

                <Border Style="{StaticResource SettingsGroupBorderStyle}">
                    <StackPanel>
                        <cwc:SettingsCard
                            Margin="0"
                            Padding="16,16"
                            BorderThickness="0"
                            Header="当前目录">
                            <cwc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </cwc:SettingsCard.HeaderIcon>
                            <cwc:SettingsCard.Description>
                                <TextBlock
                                    x:Name="DataPathText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </cwc:SettingsCard.Description>
                            <Button
                                MinWidth="96"
                                Click="OnOpenDataDirectory"
                                Content="打开文件夹"
                                Style="{StaticResource SettingButtonStyle}" />
                        </cwc:SettingsCard>

                        <Border Style="{StaticResource SettingsGroupDividerStyle}" />

                        <cwc:SettingsCard
                            Margin="0"
                            Padding="16,16"
                            BorderThickness="0"
                            Click="OnMigrateDataDirectory"
                            Header="迁移到其它目录"
                            IsClickEnabled="True">
                            <cwc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8DA;" />
                            </cwc:SettingsCard.HeaderIcon>
                            <cwc:SettingsCard.Description>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="复制整个目录后重启生效，旧目录在下次启动时清理"
                                    TextWrapping="Wrap" />
                            </cwc:SettingsCard.Description>
                        </cwc:SettingsCard>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</shuxc:ScopedPage>
