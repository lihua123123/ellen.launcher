<ContentDialog
    x:Class="Ellen.Launcher.UI.Xaml.View.Dialog.TeyvatMapSourceNoticeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Ellen.Launcher.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewTeyvatMapSourceNoticeTitle}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel MaxWidth="360" Spacing="8">
        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{shuxm:ResourceString Name=ViewTeyvatMapSourceNoticeContent}"
            TextWrapping="Wrap"/>
        <HyperlinkButton
            Content="https://yuanshen.site/docs/"
            NavigateUri="https://yuanshen.site/docs/"/>
    </StackPanel>
</ContentDialog>
